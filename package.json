{
  "name": "ezstart",
  "description": "Mono repo for ezstart projects",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:api": "pnpm --filter @ezstart/config --filter @ezstart/express-core build",
    "build:ezstart-api": "pnpm build:api && turbo build --filter=api-ezstart",
    "build:ezauth-api": "pnpm build:api && turbo build --filter=api-ezauth",
    "build:ezpay-api": "pnpm build:api && turbo build --filter=api-ezpay",
    "build:ezbill-api": "pnpm build:api && turbo build --filter=api-ezbill",
    "build:green-pulse-api": "pnpm build:api && turbo build --filter=api-green-pulse",
    "build:ga-api": "pnpm build:api && turbo build --filter=api-game-analyzer",
    "build:ga-web": "turbo build --filter=web-game-analyzer",
    "dev:types": "tsc -b --watch",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "kill:ports": "powershell -ExecutionPolicy Bypass -File .\\scripts\\tools\\kill-ports.ps1",
    "dev:status": "powershell -ExecutionPolicy Bypass -File .\\scripts\\tools\\dev-status.ps1",
    "dev:ez": "turbo run dev --filter=web-ezstart... --filter=api-ezstart... --concurrency=10",
    "dev:bill": "turbo run dev --filter=web-ezbill... --filter=api-ezbill... --filter=web-ezauth... --filter=api-ezauth... --concurrency=15",
    "dev:pay": "turbo run dev --filter=web-ezpay... --filter=api-ezpay... --concurrency=15",
    "dev:fs": "turbo run dev --filter=web-fengshui... --filter=web-ezauth... --filter=api-ezauth... --filter=web-ezpay... --filter=api-ezpay... --concurrency=15",
    "dev:gp": "turbo run dev --filter=web-green-pulse... --filter=api-green-pulse... --filter=@green-pulse/types... --filter=web-ezauth... --filter=api-ezauth... --concurrency=15",
    "dev:ga": "turbo run dev --filter=web-game-analyzer... --filter=api-game-analyzer... --filter=web-ezauth... --filter=api-ezauth... --concurrency=15",
    "dev:asc": "turbo run dev --filter=web-asc-tcd...",
    "dev:all": "turbo dev --concurrency 50",
    "icons:generate": "node packages/next-config/scripts/generate-all-icons.js"
  },
  "jest": {
    "projects": [
      "<rootDir>/apps/ezstart/api"
    ]
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.0",
    "concurrently": "^9.1.2",
    "@ezstart/eslint-config": "workspace:*",
    "@ezstart/typescript-config": "workspace:*",
    "@next/bundle-analyzer": "^16.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "eslint": "^9.27.0",
    "fs-extra": "^11.3.0",
    "jest": "^29.7.0",
    "ora": "^5.4.1",
    "prettier": "^3.5.1",
    "rimraf": "^6.1.2",
    "sharp": "^0.34.4",
    "ts-jest": "^29.3.4",
    "ts-prune": "^0.10.3",
    "tsx": "^4.20.3",
    "turbo": "^2.4.2",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.12.2+sha256.07b2396c6c99a93b75b5f9ce22be9285c3b2533c49fec51b349d44798cf56b82",
  "engines": {
    "node": "20.18.x",
    "pnpm": "10.12.x"
  },
  "pnpm": {
    "overrides": {
      "zod": "3.23.8",
      "fast-xml-parser": ">=5.3.7"
    }
  },
  "dependencies": {
    "@eslint/js": "^9.29.0",
    "@react-pdf/renderer": "^4.3.0"
  }
}
