{
  "name": "ezstart",
  "description": "Mono repo for ezstart projects",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --concurrency 50",
    "dev:billing": "turbo run dev --filter=web-ez-billing... --filter=api-ez-billing... --filter=web-ezauth... --filter=api-ezauth... --concurrency=15",
    "dev:td": "turbo run dev --filter=web-tower-defense... --filter=api-tower-defense... --filter=web-ezauth... --filter=api-ezauth... --concurrency=15",
    "dev:ez": "turbo run dev --filter=web-ezstart...",
    "dev:asc": "turbo run dev --filter=web-asc-tcd...",
    "dev:fs": "turbo run dev --filter=web-fengshui...",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check:ports": "netstat -ano | findstr \":3000 :3001 :4000 :4001 :5000 :5001 :6000 :6001 :7000 :7001 :8000 :8001 :8080 :8081 \""
  },
  "jest": {
    "projects": [
      "<rootDir>/apps/ezstart/api"
    ]
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@ezstart/eslint-config": "workspace:*",
    "@ezstart/typescript-config": "workspace:*",
    "eslint": "^9.27.0",
    "fs-extra": "^11.3.0",
    "jest": "^29.7.0",
    "ora": "^5.4.1",
    "prettier": "^3.5.1",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.3.4",
    "ts-prune": "^0.10.3",
    "tsx": "^4.20.3",
    "turbo": "^2.4.2",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.12.2+sha256.07b2396c6c99a93b75b5f9ce22be9285c3b2533c49fec51b349d44798cf56b82",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@eslint/js": "^9.29.0",
    "@react-pdf/renderer": "^4.3.0",
    "zod": "^3.25.28"
  }
}
