{
  "name": "ezstart",
  "description": "Mono repo for ezstart projects",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:api": "pnpm --filter @ezstart/config --filter @ezstart/express-core build",
    "build:ezstart-api": "pnpm build:api && turbo build --filter=api-ezstart",
    "build:ezauth-api": "pnpm build:api && turbo build --filter=api-ezauth",
    "build:ezpay-api": "pnpm build:api && turbo build --filter=api-ezpay",
    "build:ezbill-api": "pnpm build:api && turbo build --filter=api-ezbill",
    "build:green-pulse-api": "pnpm build:api && turbo build --filter=api-green-pulse",
    "build:ga-api": "pnpm build:api && turbo build --filter=api-gacha-analyzer",
    "build:ga-web": "turbo build --filter=web-gacha-analyzer",
    "dev": "node scripts/tools/dev.js",
    "dev:packages": "tsc -b --watch tsconfig.build-packages.json",
    "rotate-secrets": "node scripts/tools/rotate-secrets.js",
    "validate-env": "node scripts/tools/validate-env.js",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "kill:ports": "powershell -ExecutionPolicy Bypass -File .\\scripts\\tools\\kill-ports.ps1",
    "dev:status": "powershell -ExecutionPolicy Bypass -File .\\scripts\\tools\\dev-status.ps1",
    "icons:generate": "node packages/next-config/scripts/generate-all-icons.js",
    "check:i18n": "node scripts/tools/check-i18n.js",
    "check:size": "node scripts/tools/check-component-size.js",
    "check:dead-code": "node scripts/tools/check-dead-code.js",
    "prepare": "husky",
    "setup:env": "node scripts/tools/setup-env.js",
    "registry:update": "node scripts/generators/generate-ui-registry.js",
    "stripe": "stripe listen --forward-to localhost:6130/api/webhooks/stripe"
  },
  "lint-staged": {
    "package.json": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "prettier --write",
      "bash scripts/tools/lint-rules.sh"
    ],
    "*.{js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "jest": {
    "projects": [
      "<rootDir>/apps/ezstart/api"
    ]
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.0",
    "@ezstart/eslint-config": "workspace:*",
    "@ezstart/typescript-config": "workspace:*",
    "@next/bundle-analyzer": "^16.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "concurrently": "^9.1.2",
    "eslint": "^9.27.0",
    "fs-extra": "^11.3.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.4.0",
    "ora": "^5.4.1",
    "prettier": "^3.5.1",
    "rimraf": "^6.1.2",
    "sharp": "^0.34.4",
    "ts-jest": "^29.3.4",
    "ts-prune": "^0.10.3",
    "tsx": "^4.20.3",
    "turbo": "^2.9.3",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.12.2+sha256.07b2396c6c99a93b75b5f9ce22be9285c3b2533c49fec51b349d44798cf56b82",
  "engines": {
    "node": "20.18.x",
    "pnpm": "10.12.x"
  },
  "pnpm": {
    "overrides": {
      "zod": "3.23.8",
      "fast-xml-parser": ">=5.3.7"
    }
  },
  "dependencies": {
    "@eslint/js": "^9.29.0",
    "@react-pdf/renderer": "^4.3.0"
  }
}
