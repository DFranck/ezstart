  "workflow": {
    "usage": "Tag agent in question: @backend, @frontend, @infrastructure, etc.",
    "steps": [
      "1. Agent reads .claude/config.json (common rules)",
      "2. Agent reads .claude/agents.json (this file - specific mission)",
      "3. Agent reads SSOT files (code, audits) for dynamic data",
      "4. Agent executes task (AUPD: Audit → Update → Propose → Document)",
      "5. Agent updates audit files ONLY if metrics changed",
      "6. Agent logs rule changes in .claude/rules-log.json if new pattern"
    ],
    "example": "@backend optimize the getUserById route in ezauth API"
  },

  "decisionMatrix": {
    "description": "Which agent to use for which task",
    "examples": {
      "Add API route": "@backend",
      "Optimize MongoDB query": "@backend",
      "Fix CORS issue": "@backend",
      "Create UI component": "@frontend",
      "Improve mobile UX": "@frontend",
      "Fix accessibility": "@frontend",
      "Deploy to Railway": "@infrastructure",
      "Setup monitoring": "@infrastructure",
      "Update dependencies": "@infrastructure",
      "Refactor packages": "@architecture",
      "Add tests": "@architecture",
      "Improve code quality": "@architecture",
      "Write README": "@content",
      "Optimize SEO": "@content",
      "Add translations": "@content",
      "Integrate Stripe": "@integrations",
      "Optimize bundle size": "@integrations",
      "Add external API": "@integrations"
    }
  },

  "globalScore": {
    "current": 96.6,
    "target": 100,
    "breakdown": {
      "backend": 96,
      "frontend": 94,
      "infrastructure": 91,
