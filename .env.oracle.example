# ============================================
# Oracle Cloud - Environment Variables
# ============================================
# Copy this file to .env on your Oracle VM
# Fill in the real values (DO NOT commit .env)

# ======================
# EZAuth API (Port 5010)
# ======================
EZAUTH_MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/ezauth?retryWrites=true&w=majority
EZAUTH_JWT_SECRET=change-me-to-a-secure-random-string-min-32-chars
EZAUTH_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
EZAUTH_GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
EZAUTH_GOOGLE_CALLBACK_URL=https://ezauth.ezstart.xyz/api/auth/google/callback
EZAUTH_ALLOWED_ORIGINS=https://ezauth.vercel.app,https://ezstart-ezbill.vercel.app,https://tower-defense-web.vercel.app,https://ezstart-ezpay.vercel.app
EZAUTH_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ======================
# EZPay API (Port 5040)
# ======================
EZPAY_MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/ezpay?retryWrites=true&w=majority
EZPAY_STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
EZPAY_STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
EZPAY_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key
EZPAY_WEB_URL=https://ezpay.ezstart.xyz
EZPAY_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ======================
# EZBill API (Port 5020)
# ======================
EZBILL_MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/ezbill?retryWrites=true&w=majority
EZBILL_JWT_SECRET=change-me-to-a-secure-random-string-min-32-chars
EZBILL_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ======================
# Tower Defense API (Port 5030)
# ======================
TD_MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/tower-defense?retryWrites=true&w=majority
TD_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ======================
# GreenPulse API (Port 5070)
# ======================
GP_MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/green-pulse?retryWrites=true&w=majority
GP_GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GP_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ======================
# Monitoring API (Port 5000)
# ======================
MONITORING_MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/monitoring?retryWrites=true&w=majority
MONITORING_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
HEALTH_CHECK_INTERVAL=600000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3
