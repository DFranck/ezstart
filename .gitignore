# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js
@ezstart.code-workspace

# Local env files (allow .env.example templates)
.env
.env.local
.env.*.local
.env.production
!.env.example

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist

# PWA files (auto-generated by next-pwa)
**/public/sw.js
**/public/workbox-*.js

# Debug
npm-debug.log*

# Misc
.DS_Store
*.pem
note.md

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Claude settings (only ignore truly local/private configs)
.claude/settings.local.json
.claude/**/local/**
.claude/**/*.local.*
