# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js
@ezstart.code-workspace

# Local env files (allow .env.example templates)
.env
.env.local
.env.*.local
.env.production
.env.test
!.env.example

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist

# PWA files (auto-generated by next-pwa)
**/public/sw.js
**/public/workbox-*.js

# Debug
npm-debug.log*

# Misc
.DS_Store
*.pem
note.md

# Audit reports (generated files)
health-check-report.json
audit-report.json

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Claude settings (only ignore truly local/private configs)
.claude/settings.local.json
.claude/**/local/**
.claude/**/*.local.*
.claude/worktrees/
.claude/scheduled_tasks.lock

# Temporary logs and test files
test-*.log
typecheck-*.log
test-*.json

# OCR bench test images
test-images/

# Dev credentials (never commit)
.dev-users.md

# Local tmp (screenshots, scratch)
tmp/

# Auto-generated files — regenerated via `turbo run generate`
# Source of truth lives in the non-generated counterpart (CSS, components, etc.).
# Never commit these; never edit by hand.
**/*.generated.ts
**/generated/**

# PWA generated assets (regenerated by pnpm generate via @ezstart/next-config)
# Source: apps/*/web/public/logo.* + manifest.config.json
apps/*/web/public/icons/
apps/*/web/public/apple-touch-icon.png
apps/*/web/public/favicon.png
