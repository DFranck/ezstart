{
  "name": "@ezstart/rbac",
  "version": "1.0.0",
  "description": "Role-Based Access Control utilities for @ezstart monorepo",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./dist/server.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./dist/types.js"
    },
    "./helpers": {
      "types": "./src/helpers.ts",
      "default": "./dist/helpers.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ezstart/auth-sdk": "workspace:*",
    "@ezstart/ui": "workspace:*",
    "react": "^19.1.1"
  },
  "devDependencies": {
    "@ezstart/typescript-config": "workspace:*",
    "@types/express": "^4.17.17",
    "@types/react": "^19.1.12",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "react": "^19.1.1"
  }
}
