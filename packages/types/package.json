{
  "name": "@ezstart/types",
  "version": "0.1.0",
  "description": "Shared Zod with OpenAPI extension for @ezstart APIs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}