{
  "name": "@ezstart/api-contracts",
  "version": "1.0.0",
  "description": "Wire contracts (TypeScript types + Zod schemas) shared between @ezstart API clients and servers — envelope, pagination, error codes, auth flows.",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DFranck/ezstart.git",
    "directory": "packages/api-contracts"
  },
  "homepage": "https://github.com/DFranck/ezstart/tree/master/packages/api-contracts",
  "bugs": {
    "url": "https://github.com/DFranck/ezstart/issues"
  },
  "keywords": [
    "api",
    "contracts",
    "zod",
    "validation",
    "envelope",
    "pagination",
    "ezstart"
  ],
  "author": "EzStart LLC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {},
  "peerDependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@ezstart/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0",
    "zod": "^3.23.8"
  }
}
