{
  "name": "@ezstart/ocr-sdk",
  "version": "1.0.0",
  "description": "OCR SDK with Tesseract.js engine and extensible game parsers",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DFranck/ezstart.git",
    "directory": "packages/ocr-sdk"
  },
  "homepage": "https://github.com/DFranck/ezstart/tree/master/packages/ocr-sdk",
  "bugs": {
    "url": "https://github.com/DFranck/ezstart/issues"
  },
  "keywords": [
    "ocr",
    "tesseract",
    "sdk",
    "ezstart"
  ],
  "author": "EzStart LLC",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@ezstart/typescript-config": "workspace:*",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.3"
  }
}
