{
  "name": "@ezstart/express-core",
  "description": "DEPRECATED — Express.js infrastructure for @ezstart API services. Use @ezstart/api-core instead.",
  "version": "0.0.1",
  "private": true,
  "deprecated": "Use @ezstart/api-core instead. This package is kept for transitional app code that has not migrated yet (route files, models, middleware).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "dev": "tsc -b --watch",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./cors": {
      "types": "./dist/config/cors.d.ts",
      "import": "./dist/config/cors.js",
      "require": "./dist/config/cors.js"
    }
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@ezstart/config": "workspace:*",
    "@ezstart/logger": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "express-rate-limit": "^7.5.1",
    "mongoose": "^8.15.1",
    "socket.io": "^4.8.1",
    "swagger-autogen": "^2.23.7",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@ezstart/eslint-config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/socket.io": "^3.0.2",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yamljs": "^0.2.34",
    "supertest": "^7.1.4",
    "typescript": "^5.7.3",
    "vitest": "^4.0.3"
  }
}
