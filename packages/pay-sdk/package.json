{
  "name": "@ezstart/pay-sdk",
  "version": "1.0.0",
  "description": "Payment SDK with 3-layer architecture: agnostic core, React bindings, and pre-built UI components",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DFranck/ezstart.git",
    "directory": "packages/pay-sdk"
  },
  "homepage": "https://github.com/DFranck/ezstart/tree/master/packages/pay-sdk",
  "bugs": {
    "url": "https://github.com/DFranck/ezstart/issues"
  },
  "keywords": [
    "payments",
    "stripe",
    "sdk",
    "ezstart"
  ],
  "author": "EzStart LLC",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./providers": {
      "types": "./dist/core/providers/index.d.ts",
      "import": "./dist/core/providers/index.js"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ezstart/config": "workspace:*",
    "@ezstart/logger": "workspace:*",
    "@ezstart/ui": "workspace:*",
    "sonner": "^2.0.3",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@ezstart/typescript-config": "workspace:*",
    "@types/node": "^20",
    "@types/react": "^19.1.12",
    "next": "^15.5.9",
    "react": "^19.1.1",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "next": "^15",
    "react": "^18"
  }
}
