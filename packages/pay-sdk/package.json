{
  "name": "@ezstart/pay-sdk",
  "version": "1.0.0",
  "description": "EZPay React SDK for payments, donations, and subscriptions",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ezstart/config": "workspace:*",
    "@ezstart/ui": "workspace:*",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@ezstart/typescript-config": "workspace:*",
    "@types/node": "^20",
    "@types/react": "^19.1.12",
    "next": "15.5.9",
    "react": "^19.1.1",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "next": "^15",
    "react": "^18"
  }
}
