{
  "name": "@ezstart/config",
  "version": "0.0.1",
  "description": "Centralized configuration for all environments, URLs, and CORS",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./urls": {
      "import": "./dist/urls.js",
      "types": "./dist/urls.d.ts"
    },
    "./cors": {
      "import": "./dist/cors.js",
      "types": "./dist/cors.d.ts"
    },
    "./env": {
      "import": "./dist/env.js",
      "types": "./dist/env.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@ezstart/typescript-config": "workspace:*",
    "@types/node": "^20",
    "typescript": "^5.7.3"
  }
}
