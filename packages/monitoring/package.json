{
  "name": "@ezstart/monitoring",
  "version": "1.0.0",
  "type": "module",
  "description": "Centralized monitoring, auditing, and health check system for @ezstart monorepo",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "monitoring",
    "audit",
    "health-check",
    "observability"
  ],
  "dependencies": {
    "@ezstart/config": "workspace:*",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ezstart/typescript-config": "workspace:*",
    "@types/react": "^19.1.12",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "typescript": "^5.7.2"
  }
}
