{
  "name": "@ezstart/monitoring",
  "version": "1.0.0",
  "description": "Centralized monitoring, auditing, and health check system for @ezstart monorepo",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DFranck/ezstart.git",
    "directory": "packages/monitoring"
  },
  "homepage": "https://github.com/DFranck/ezstart/tree/master/packages/monitoring",
  "bugs": {
    "url": "https://github.com/DFranck/ezstart/issues"
  },
  "author": "EzStart LLC",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "monitoring",
    "audit",
    "health-check",
    "observability"
  ],
  "dependencies": {
    "@ezstart/config": "workspace:*",
    "@ezstart/logger": "workspace:*",
    "@ezstart/ui": "workspace:*",
    "date-fns": "^4.1.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "next": "^15.5.9",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ezstart/typescript-config": "workspace:*",
    "@types/react": "^19.1.12",
    "next": "^15.5.9",
    "react": "^19.1.1",
    "typescript": "^5.7.2"
  }
}
