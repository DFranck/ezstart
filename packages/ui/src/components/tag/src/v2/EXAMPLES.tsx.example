/**
 * EzTag v2 - Examples
 *
 * Copy-paste examples for common use cases
 */

import { Button } from '../../../button'
import {
  Article,
  Aside,
  Div,
  EzTag,
  Footer,
  H1,
  H2,
  H3,
  Header,
  Main,
  Nav,
  P,
  Section,
} from './index'

// ============================================================================
// EXAMPLE 1: Landing Page Hero
// ============================================================================

export function HeroExample() {
  return (
    <Section layout="col" size="xl" ariaLabel="Hero section">
      <Div layout="center" size="lg">
        <H1 size="giant">Welcome to EzStart</H1>
        <P size="lg" variant="muted">
          Build amazing apps with our design system
        </P>
        <Div layout="row" size="sm">
          <Button variant="primary" size="lg">
            Get Started
          </Button>
          <Button variant="outline" size="lg">
            Learn More
          </Button>
        </Div>
      </Div>
    </Section>
  )
}

// ============================================================================
// EXAMPLE 2: Features Grid
// ============================================================================

export function FeaturesGridExample() {
  const features = [
    { id: 1, title: 'Fast', description: 'Lightning-fast performance', icon: '⚡' },
    { id: 2, title: 'Accessible', description: 'WCAG 2.1 compliant', icon: '♿' },
    { id: 3, title: 'Type-Safe', description: 'Full TypeScript support', icon: '🔒' },
    { id: 4, title: 'Themeable', description: 'Customizable design system', icon: '🎨' },
  ]

  return (
    <Section layout="col" size="lg" ariaLabel="Features section">
      <Div layout="center" size="md">
        <H2 size="h2">Our Features</H2>
        <P variant="muted">Everything you need to build great products</P>
      </Div>
      <Div layout="grid" size="md">
        {features.map(feature => (
          <Div key={feature.id} variant="card" size="md" layout="col" align="center">
            <Div className="text-4xl mb-4">{feature.icon}</Div>
            <H3 size="h4">{feature.title}</H3>
            <P variant="muted" className="text-center">
              {feature.description}
            </P>
          </Div>
        ))}
      </Div>
    </Section>
  )
}

// ============================================================================
// EXAMPLE 3: Status Notifications
// ============================================================================

export function StatusNotificationsExample() {
  return (
    <Div layout="col" size="sm">
      <Div intent="success" variant="card" size="sm" ariaLabel="Success notification">
        ✅ Changes saved successfully
      </Div>
      <Div intent="warning" variant="card" size="sm" ariaLabel="Warning notification">
        ⚠️ Your session expires in 5 minutes
      </Div>
      <Div intent="danger" variant="card" size="sm" ariaLabel="Error notification">
        ❌ Failed to upload file
      </Div>
      <Div intent="info" variant="card" size="sm" ariaLabel="Info notification">
        ℹ️ New features available
      </Div>
    </Div>
  )
}

// ============================================================================
// EXAMPLE 4: Sidebar Layout
// ============================================================================

export function SidebarLayoutExample() {
  return (
    <Div layout="row" size="full">
      {/* Sidebar */}
      <Aside layout="col" size="md" variant="card" ariaLabel="Main navigation">
        <H3 size="h5">Navigation</H3>
        <Nav layout="col">
          <a href="/dashboard" className="hover:underline">
            Dashboard
          </a>
          <a href="/settings" className="hover:underline">
            Settings
          </a>
          <a href="/profile" className="hover:underline">
            Profile
          </a>
        </Nav>
      </Aside>

      {/* Main Content */}
      <Main layout="col" size="lg">
        <Header layout="row" align="between" size="sm">
          <H1 size="h2">Dashboard</H1>
          <Button variant="primary">New Item</Button>
        </Header>
        <Section layout="col" size="md">
          <P>Main content area</P>
        </Section>
      </Main>
    </Div>
  )
}

// ============================================================================
// EXAMPLE 5: Blog Post
// ============================================================================

export function BlogPostExample() {
  return (
    <Article layout="col" size="md" variant="card">
      <Header layout="col" size="sm">
        <H1 size="h2">Getting Started with EzTag v2</H1>
        <P variant="muted">Published on December 29, 2025</P>
      </Header>
      <Div layout="col" size="md">
        <H2 size="h3">Introduction</H2>
        <P>
          EzTag v2 is a powerful polymorphic component that makes building accessible,
          performant UI components a breeze.
        </P>
        <H2 size="h3">Key Features</H2>
        <P>
          With built-in ARIA attributes, performance optimizations, and TypeScript support,
          EzTag v2 is the perfect foundation for your design system.
        </P>
      </Div>
      <Footer layout="row" align="between" size="sm">
        <P variant="muted">By John Doe</P>
        <Button variant="outline" size="sm">
          Read More
        </Button>
      </Footer>
    </Article>
  )
}

// ============================================================================
// EXAMPLE 6: Loading State (Skeleton)
// ============================================================================

export function LoadingStateExample() {
  return (
    <Div layout="col" size="md">
      <H2 intent="skeleton" size="h2">
        Loading title...
      </H2>
      <P intent="skeleton">Loading description text that will be replaced...</P>
      <Div layout="grid" size="md">
        <Div intent="skeleton" size="md" variant="card">
          Loading card 1...
        </Div>
        <Div intent="skeleton" size="md" variant="card">
          Loading card 2...
        </Div>
        <Div intent="skeleton" size="md" variant="card">
          Loading card 3...
        </Div>
      </Div>
    </Div>
  )
}

// ============================================================================
// EXAMPLE 7: Form with Labels
// ============================================================================

export function FormExample() {
  return (
    <Div as="form" layout="col" size="md" variant="card">
      <H2 size="h3">Contact Us</H2>
      <Div layout="col" size="sm">
        <EzTag as="label" htmlFor="name">
          Name
        </EzTag>
        <input id="name" type="text" className="border rounded px-3 py-2" />
      </Div>
      <Div layout="col" size="sm">
        <EzTag as="label" htmlFor="email">
          Email
        </EzTag>
        <input id="email" type="email" className="border rounded px-3 py-2" />
      </Div>
      <Div layout="col" size="sm">
        <EzTag as="label" htmlFor="message">
          Message
        </EzTag>
        <textarea id="message" rows={4} className="border rounded px-3 py-2" />
      </Div>
      <Button variant="primary" type="submit">
        Send Message
      </Button>
    </Div>
  )
}

// ============================================================================
// EXAMPLE 8: Polymorphic with asChild
// ============================================================================

export function AsChildExample() {
  return (
    <Div layout="col" size="md">
      {/* ❌ Without asChild (nested) */}
      <Div variant="card" size="sm">
        <a href="/login">Login (nested)</a>
      </Div>
      {/* Renders: <div class="card"><a>Login</a></div> */}

      {/* ✅ With asChild (merged) */}
      <Div variant="card" size="sm" asChild>
        <a href="/login">Login (merged)</a>
      </Div>
      {/* Renders: <a href="/login" class="card">Login</a> */}

      {/* ✅ Button with asChild */}
      <Button variant="primary" asChild>
        <a href="/signup">Sign Up (as link)</a>
      </Button>
      {/* Renders: <a href="/signup" class="button-primary">Sign Up</a> */}
    </Div>
  )
}

// ============================================================================
// EXAMPLE 9: Debug Mode
// ============================================================================

export function DebugExample() {
  return (
    <Div layout="col" size="md" debug>
      <H2 size="h2" debug>
        Debug Mode Active
      </H2>
      <P debug>All components have red outline</P>
      <Div layout="grid" size="sm" debug>
        <Div variant="card" debug>
          Card 1
        </Div>
        <Div variant="card" debug>
          Card 2
        </Div>
      </Div>
    </Div>
  )
}

// ============================================================================
// EXAMPLE 10: Custom Variants with className
// ============================================================================

export function CustomVariantsExample() {
  return (
    <Div layout="col" size="md">
      {/* Combine variants with custom classes */}
      <Div
        layout="col"
        size="md"
        variant="card"
        className="hover:shadow-xl transition-shadow duration-300"
      >
        <H2 size="h3" className="text-gradient bg-clip-text bg-gradient-to-r from-blue-500 to-purple-500">
          Gradient Title
        </H2>
        <P className="italic">Custom styled content</P>
      </Div>

      {/* Responsive custom classes */}
      <Div
        layout="col"
        size="sm"
        className="md:flex-row md:items-center md:justify-between"
      >
        <H3 size="h4">Responsive Layout</H3>
        <Button variant="primary" size="sm">
          Action
        </Button>
      </Div>
    </Div>
  )
}
