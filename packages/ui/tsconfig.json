// @ezstart/packages/ui/tsconfig.json
{
  "extends": "@workspace/typescript-config/react-library.json",

  "compilerOptions": {
    "outDir": "./dist",
    "declaration": true,
    "declarationDir": "./dist",
    "composite": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "baseUrl": "."
  },
  "include": [
    "components/**/*",
    "hooks/**/*",
    "lib/**/*",
    "utils/**/*",
    "templates/**/*",
    "index.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
