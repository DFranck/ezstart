{
  "name": "@ezstart/seo-config",
  "version": "0.0.1",
  "description": "Centralized SEO configuration with robots.txt, sitemap.xml, and metadata helpers",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "default": "./dist/metadata.js"
    },
    "./metadata-enhanced": {
      "types": "./dist/metadata-enhanced.d.ts",
      "default": "./dist/metadata-enhanced.js"
    },
    "./robots": {
      "types": "./dist/robots.d.ts",
      "default": "./dist/robots.js"
    },
    "./sitemap": {
      "types": "./dist/sitemap.d.ts",
      "default": "./dist/sitemap.js"
    },
    "./json-ld": {
      "types": "./dist/json-ld.d.ts",
      "default": "./dist/json-ld.js"
    },
    "./apps": {
      "types": "./dist/apps/index.d.ts",
      "default": "./dist/apps/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "next": "^15.5.9"
  },
  "devDependencies": {
    "@ezstart/typescript-config": "workspace:*",
    "next": "^15.5.9",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@ezstart/config": "workspace:*",
    "schema-dts": "^1.1.5"
  }
}
