{
  "name": "@ezstart/eslint-plugin-ezstart",
  "version": "1.0.0",
  "description": "Custom ESLint rules that codify @ezstart monorepo conventions (api-sdk, no raw fetch/html, parseApiError, AlertDialog over confirm).",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DFranck/ezstart.git",
    "directory": "packages/eslint-plugin-ezstart"
  },
  "homepage": "https://github.com/DFranck/ezstart/tree/master/packages/eslint-plugin-ezstart",
  "bugs": {
    "url": "https://github.com/DFranck/ezstart/issues"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "ezstart",
    "lint-rules"
  ],
  "author": "EzStart LLC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.24.1"
  },
  "peerDependencies": {
    "eslint": "^8.0.0 || ^9.0.0"
  },
  "devDependencies": {
    "@ezstart/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.24.1",
    "@typescript-eslint/rule-tester": "^8.24.1",
    "eslint": "^9.27.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
