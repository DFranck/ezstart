{
  "name": "@ezstart/ai-chat",
  "version": "1.0.0",
  "description": "Reusable AI chat system with configurable providers, preprompts, and streaming support",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ezstart/fetch-client": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@ezstart/typescript-config": "workspace:*",
    "@types/react": "^19.1.12",
    "typescript": "^5.7.2"
  }
}