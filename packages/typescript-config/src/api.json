{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Node/Express + React JSX (API)",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "types": ["node"]
  }
}
