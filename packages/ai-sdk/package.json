{
  "name": "@ezstart/ai-sdk",
  "version": "1.0.0",
  "type": "module",
  "description": "Unified AI SDK with multi-provider support (OpenAI, Gemini, Claude) for backend and frontend",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ezstart/config": "workspace:*",
    "@ezstart/fetch-client": "workspace:*",
    "@ezstart/logger": "workspace:*",
    "@google/generative-ai": "^0.21.0",
    "@tanstack/react-query": "^5.0.0",
    "openai": "^4.77.3",
    "zod": "^3.23.0",
    "zustand": "^4.5.5",
    "@ezstart/ui": "workspace:*",
    "@ezstart/auth-sdk": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@ezstart/typescript-config": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.12",
    "react": "^19.1.1",
    "typescript": "^5.7.2"
  }
}
