{
  "name": "@ezstart/auth-sdk",
  "version": "1.0.0",
  "description": "EZAuth React SDK for authentication",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "import": "./dist/middleware/index.js"
    },
    "./rbac": {
      "types": "./dist/rbac/index.d.ts",
      "import": "./dist/rbac/index.js"
    },
    "./rbac/client": {
      "types": "./dist/rbac/client.d.ts",
      "import": "./dist/rbac/client.js"
    },
    "./rbac/server": {
      "types": "./dist/rbac/server.d.ts",
      "import": "./dist/rbac/server.js"
    },
    "./rbac/types": {
      "types": "./dist/rbac/types.d.ts",
      "import": "./dist/rbac/types.js"
    },
    "./rbac/helpers": {
      "types": "./dist/rbac/helpers.d.ts",
      "import": "./dist/rbac/helpers.js"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ezstart/api-contracts": "workspace:*",
    "@ezstart/api-sdk": "workspace:*",
    "@ezstart/capture-sdk": "workspace:*",
    "@ezstart/config": "workspace:*",
    "@ezstart/logger": "workspace:*",
    "@ezstart/ui": "workspace:*",
    "react-hook-form": "^7.68.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@ezstart/typescript-config": "workspace:*",
    "@types/express": "^4.17.17",
    "@types/node": "^20",
    "@types/react": "^19.1.12",
    "next": "^15.5.9",
    "next-intl": "^4.3.12",
    "react": "^19.1.1",
    "sonner": "^2.0.7",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "next": "^15",
    "next-intl": "^4",
    "react": "^18",
    "sonner": "^1 || ^2"
  }
}
