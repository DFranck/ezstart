{
  "name": "@ezstart/auth-sdk",
  "version": "1.0.0",
  "description": "EZAuth React SDK for authentication",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zustand": "^4.5.5",
    "@ezstart/ui": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@ezstart/typescript-config": "workspace:*",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "react": "^18",
    "next": "^15"
  }
}
