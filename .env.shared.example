# ============================================================
# @ezstart — Monorepo root secrets (TEMPLATE)
# ============================================================
# Copy this file to:
#   - .env.local        (local dev — gitignored)
#   - .env.production   (production — gitignored; or set via Railway/Vercel UI)
#
# ARCHITECTURE: root-only, prefixed.
#
# Two kinds of vars live here, loaded by @ezstart/config/secrets-loader:
#
#   1. SHARED (no prefix)       — exported as-is for every app.
#   2. PER-APP ({PREFIX}_NAME)  — the loader strips `{PREFIX}_` at boot
#                                  for the booting app, and IGNORES vars
#                                  for other apps (no leaks).
#
# Known app prefixes:
#   EZAUTH_  EZBILL_  EZPAY_  EZSTART_  GREENPULSE_
#   GACHA_ANALYZER_  FENGSHUI_  ASC_TCD_
#
# `NEXT_PUBLIC_*` are NEVER prefixed (Next.js convention).
#
# ⚠️ NEVER commit the real values — only this template.
# ============================================================

# ============================================================
# SHARED — Node
# ============================================================
NODE_ENV=development

# ============================================================
# SHARED — AI providers
# ============================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ============================================================
# SHARED — Email (Resend)
# Note: each app's "from" address is hardcoded in its
# email.service.ts (no EMAIL_FROM env var).
# ============================================================
RESEND_API_KEY=

# ============================================================
# SHARED — Sentry (org-level tokens; per-project DSN is per-app)
# ============================================================
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=

# ============================================================
# SHARED — MongoDB Atlas admin API
# ============================================================
MONGODB_ATLAS_PUBLIC_KEY=
MONGODB_ATLAS_PRIVATE_KEY=
MONGODB_ATLAS_PROJECT_ID=

# ============================================================
# SHARED — Infra CLIs
# ============================================================
GITHUB_TOKEN=
GITHUB_USERNAME=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
RAILWAY_TOKEN=

# ============================================================
# SHARED — External APIs
# ============================================================
EXCHANGE_RATE_API_KEY=

# ============================================================
# SHARED — JWT (same across all apps → SSO interop)
# ============================================================
JWT_SECRET=

# ============================================================
# SHARED — Stripe (consumed by ezpay for payments
# and by ezstart for read-only service dashboard)
# ============================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ============================================================
# PER-APP — MongoDB connection strings ({PREFIX}_MONGO_URL)
# ============================================================
EZAUTH_MONGO_URL=
EZBILL_MONGO_URL=
EZPAY_MONGO_URL=
EZSTART_MONGO_URL=
GREENPULSE_MONGO_URL=
GACHA_ANALYZER_MONGO_URL=
FENGSHUI_MONGO_URL=

# ============================================================
# PER-APP — Sentry project DSNs ({PREFIX}_SENTRY_DSN)
# ============================================================
EZAUTH_SENTRY_DSN=
EZBILL_SENTRY_DSN=
EZPAY_SENTRY_DSN=
EZSTART_SENTRY_DSN=
GREENPULSE_SENTRY_DSN=
GACHA_ANALYZER_SENTRY_DSN=

# ============================================================
# EZAUTH — OAuth Google + SSO + cookies
# ============================================================
EZAUTH_GOOGLE_CLIENT_ID=
EZAUTH_GOOGLE_CLIENT_SECRET=
EZAUTH_GOOGLE_CALLBACK_URL=
EZAUTH_OAUTH_STATE_SECRET=
EZAUTH_OAUTH_ENCRYPTION_KEY=
EZAUTH_ACCESS_TOKEN_EXPIRES_IN=
EZAUTH_COOKIE_DOMAIN=
EZAUTH_SSO_ALLOWED_REDIRECTS=
EZAUTH_REQUIRE_VERIFIED_EMAIL_FOR_SSO=false

# ============================================================
# EZBILL — cron + runtime
# ============================================================
EZBILL_RUN_EXCHANGE_RATES_ON_START=false

# ============================================================
# EZPAY — (Stripe keys are SHARED — see above)
# ============================================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ============================================================
# EZSTART — Monitoring
# ============================================================
EZSTART_HEALTH_CHECK_INTERVAL=
EZSTART_HEALTH_CHECK_TIMEOUT=
EZSTART_HEALTH_CHECK_RETRIES=

# ============================================================
# GREENPULSE — ESG + webhooks
# ============================================================
GREENPULSE_ESG_CLIENT_ID=
GREENPULSE_ESG_CLIENT_SECRET=
GREENPULSE_ESG_BASE_URL=
GREENPULSE_WEBHOOK_SIGNING_SECRET=
GREENPULSE_MAX_FILE_SIZE=
GREENPULSE_UPLOAD_DIR=
GREENPULSE_CORS_ORIGIN=
GREENPULSE_LOG_LEVEL=

# GreenPulse web: NEXT_PUBLIC_* (NOT prefixed)
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_DESCRIPTION=
NEXT_PUBLIC_MAX_FILE_SIZE=
NEXT_PUBLIC_ALLOWED_FILE_TYPES=
NEXT_PUBLIC_EZAUTH_JWT_PUBLIC_KEY=

# ============================================================
# Test accounts (shared dev) — single super admin used by every app via SSO.
# This account has the global superadmin role; no per-app test fixtures needed.
# ============================================================
TEST_GLOBAL_EMAIL=
TEST_GLOBAL_USERNAME=
TEST_GLOBAL_PASSWORD=
