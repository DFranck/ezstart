# ============================================================
# @ezstart — Shared secrets template (monorepo root)
# ============================================================
# Copy this file to:
#   - .env.local        (local development — gitignored)
#   - .env.production   (production — gitignored, usually set in Railway/Vercel UI)
#
# Vars placed here are loaded for ALL apps (API + web) via
# @ezstart/config/secrets-loader and @ezstart/next-config.
#
# App-specific overrides live in apps/{app}/{api|web}/.env.local
# and win over anything set here.
#
# ⚠️ NEVER commit the real values — only this template.
# ============================================================

# === AI providers ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# === Email (Resend) ===
RESEND_API_KEY=

# === Error tracking & monitoring (Sentry) ===
# Per-project DSNs stay in apps/{app}/api/.env.local.
# These are the ORG-level tokens used by the monitoring dashboard.
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=

# === MongoDB Atlas (admin API — used by monitoring / Atlas CLI) ===
# DB connection strings (MONGO_URL) stay per-app.
MONGODB_ATLAS_PUBLIC_KEY=
MONGODB_ATLAS_PRIVATE_KEY=
MONGODB_ATLAS_PROJECT_ID=

# === Infra CLIs (Services tab, deploy scripts) ===
VERCEL_TOKEN=
VERCEL_TEAM_ID=
RAILWAY_TOKEN=
GITHUB_TOKEN=
GITHUB_USERNAME=

# === External APIs (shared between several apps) ===
EXCHANGE_RATE_API_KEY=
