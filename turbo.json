{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "generate": {
      "inputs": [
        "src/**/*.css",
        "src/**/*.json",
        "src/**/*.yaml",
        "src/**/*.svg",
        "src/**/*.ts",
        "src/**/*.tsx",
        "scripts/**",
        "package.json",
        "public/logo.*",
        "!src/**/*.generated.ts",
        "!src/**/generated/**"
      ],
      "outputs": [
        "src/**/*.generated.ts",
        "src/**/generated/**",
        "../../apps/ezstart/web/src/app/**/inspector/registry.generated.ts"
      ],
      "cache": true
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "**/dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "generate"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    }
  }
}
