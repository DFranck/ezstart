# ============================================================
# EZBill API — .env.example
# ============================================================

# ── Shared across ALL apps ────────────────────────────────
DEPLOY_ENV=local
MONGO_URL=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>/{app}?retryWrites=true&w=majority
JWT_SECRET=
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=ezstart

# ── Email ─────────────────────────────────────────────────
RESEND_API_KEY=

# ── AI (invoice categorization via Gemini) ────────────────
GEMINI_API_KEY=

# ── Cron: startup exchange-rates refresh toggle ──────────
# Set to 'true' to run an initial fetch on API boot. Default false.
RUN_EXCHANGE_RATES_ON_START=false

# ── Sentry runtime DSN ───────────────────────────────────
SENTRY_DSN=

# ── Logger verbosity ─────────────────────────────────────
LOG_LEVEL=info

# ── (deprecated, pending Frankfurter migration) ──────────
# EXCHANGE_RATE_API_KEY=
