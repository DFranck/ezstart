# ============================================================
# EZBill API — .env.example
# ============================================================
# Per-app cascade (NO root layer):
#   local      → .env.local
#   staging    → .env.local ← .env.staging  (staging overrides)
#   production → .env.local ← .env.production (prod overrides)
# ============================================================

# ── Node / Deploy environment ───────────────────────────────
NODE_ENV=development
DEPLOY_ENV=local

# ── MongoDB (templated — {app} resolved via getMongoUrl) ─────
MONGO_URL=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>/{app}?retryWrites=true&w=majority

# ── JWT — SSO interop, MUST match other apps ────────────────
JWT_SECRET=<GENERATE_SECURE_64_BYTE>

# ── Sentry (build-time + org) ───────────────────────────────
SENTRY_AUTH_TOKEN=<SENTRY_AUTH_TOKEN>
SENTRY_ORG_SLUG=ezstart

# ── Email ─────────────────────────────────────────────────
RESEND_API_KEY=

# ── AI (invoice categorization via Gemini) ────────────────
GEMINI_API_KEY=

# ── Cron: startup exchange-rates refresh toggle ──────────
# Set to 'true' to run an initial fetch on API boot. Default false.
RUN_EXCHANGE_RATES_ON_START=false

# ── Sentry runtime DSN ───────────────────────────────────
SENTRY_DSN=

# ── Logger verbosity ─────────────────────────────────────
LOG_LEVEL=info

# ── (deprecated, pending Frankfurter migration) ──────────
# EXCHANGE_RATE_API_KEY=
