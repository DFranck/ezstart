# EZBill API Configuration Template  
# Copy to .env.local and fill with real values

# Server Configuration
NODE_ENV=development

# Database Configuration
# Get your MongoDB connection string from MongoDB Atlas
MONGO_URL=mongodb://localhost:27017/ezbill

# External APIs
# Get your API key from Exchange Rate API
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key-here

# AI APIs
# Get your API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ======================
# ERROR TRACKING (SENTRY)
# ======================
# Get your DSN from Sentry Dashboard: https://sentry.io/
# Project: ezbill-api
# Leave empty for development (errors will be logged to console)
# Required for production (error monitoring and alerting)
SENTRY_DSN=your-sentry-dsn-here

# ======================
# CRON CONFIGURATION (OPTIONAL)
# ======================
# Set to 'true' to run exchange rate update on server start
RUN_EXCHANGE_RATES_ON_START=false

# ======================
# AUTHENTICATION (JWT)
# ======================
# Must be the SAME secret as EZAuth — tokens signed by EZAuth are verified here
JWT_SECRET=your-jwt-secret-here-must-match-ezauth

# PORT is auto-detected from @ezstart/config (no need to set)
