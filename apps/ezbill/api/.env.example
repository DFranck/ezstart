# EZ-Billing API Configuration Template  
# Copy to .env.local and fill with real values

# Server Configuration
PORT=5020
NODE_ENV=development

# Database Configuration
# Get your MongoDB connection string from MongoDB Atlas
MONGO_URL=mongodb://localhost:27017/ezbilling

# External APIs
# Get your API key from Exchange Rate API
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key-here