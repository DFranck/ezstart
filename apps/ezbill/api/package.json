{
  "name": "api-ezbill",
  "version": "0.0.1",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "pnpm --filter @ezstart/types build && pnpm --filter @ezbill/types build",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "start:prod": "pnpm build && node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --fix",
    "migrate:receipts": "tsx src/scripts/generate-missing-receipts.ts"
  },
  "dependencies": {
    "@ezbill/types": "workspace:*",
    "@ezstart/ai-sdk": "workspace:*",
    "@ezstart/api-core": "workspace:*",
    "@ezstart/config": "workspace:*",
    "@ezstart/email-service": "workspace:*",
    "@ezstart/express-core": "workspace:*",
    "@ezstart/logger": "workspace:*",
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.19.2",
    "mongoose": "^8.15.1",
    "node-cron": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@ezstart/eslint-config": "workspace:*",
    "@ezstart/test-utils": "workspace:*",
    "@types/cors": "^2.8.18",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.6",
    "@types/node": "^20.7.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
