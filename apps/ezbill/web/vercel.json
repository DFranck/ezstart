{
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" != \"master\" ]; then exit 0; else npx turbo-ignore web-ezbill; fi",
  "buildCommand": "pnpm turbo build --filter=web-ezbill...",
  "outputDirectory": ".next",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "src/app/**/*": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://ezbill.ezstart.xyz/:path*",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "ezbill-web.vercel.app"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "master": true
    }
  }
}
