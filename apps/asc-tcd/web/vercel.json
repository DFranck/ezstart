{
  "buildCommand": "pnpm turbo build --filter=web-asc-tcd...",
  "outputDirectory": ".next",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "src/app/**/*": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/fr",
      "statusCode": 302
    }
  ],
  "git": {
    "deploymentEnabled": {
      "master": false
    }
  }
}
