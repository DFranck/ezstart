# ============================================================
# ASC-TCD Web — .env.example (landing / marketing site)
# ============================================================
# Minimal env footprint — no server-side secrets required.
# ============================================================

# ── Shared ────────────────────────────────────────────────
DEPLOY_ENV=local
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=ezstart

# ── Optional: publishable key (only if auth is actually wired) ──
# NEXT_PUBLIC_EZAUTH_KEY=

# ── Optional ──────────────────────────────────────────────
NEXT_PUBLIC_DEBUG=false
