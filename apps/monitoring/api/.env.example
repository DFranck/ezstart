# Monitoring API Environment Variables
# Copy to .env.local and fill with real values

# Server
NODE_ENV=development

# MongoDB (for storing audit results and metrics)
MONGO_URL=mongodb://localhost:27017/ezstart-monitoring

# CORS (auto-configured via @ezstart/config)
# ALLOWED_ORIGINS is automatically set based on environment

# Monitoring Configuration
# Strategy:
# - Railway APIs (EZAuth, EZPay): Check for monitoring
# - Render APIs (EZBill, TD, GreenPulse): Check to PREVENT SLEEP (free tier sleeps after 15min)
# - Vercel Web: Check for uptime
#
# Render FREE tier: 750h/month
# - Check every 10 min = keeps API awake 24/7 = ~720h/month usage ✅
# - Check every 5 min = safer margin but uses more bandwidth
#
# Railway COST: ~$0.02-0.05/month (13 checks × 144 times/day × 30 days)
HEALTH_CHECK_INTERVAL=600000  # 10 minutes (optimal for Render + low Railway cost)
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3

# External Services (optional)
# SENTRY_DSN=
# DATADOG_API_KEY=

# PORT is auto-detected from @ezstart/config (no need to set)
