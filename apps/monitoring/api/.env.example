# Monitoring API Environment Variables
# Copy to .env.local and fill with real values

# Server
NODE_ENV=development

# MongoDB (for storing audit results and metrics)
MONGO_URL=mongodb://localhost:27017/ezstart-monitoring

# CORS (auto-configured via @ezstart/config)
# ALLOWED_ORIGINS is automatically set based on environment

# Monitoring Configuration
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3

# External Services (optional)
# SENTRY_DSN=
# DATADOG_API_KEY=

# PORT is auto-detected from @ezstart/config (no need to set)
