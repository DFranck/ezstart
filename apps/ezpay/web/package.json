{
  "name": "web-ezpay",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @ezstart/ui --filter @ezstart/pay-sdk --filter @ezstart/next-theme build && next build",
    "dev": "next dev --turbopack -p 5045",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ezstart/config": "workspace:*",
    "@ezstart/next-theme": "workspace:*",
    "@ezstart/pay-sdk": "workspace:*",
    "@ezstart/ui": "workspace:*",
    "autoprefixer": "^10.4.19",
    "next": "15.5.2",
    "postcss": "^8.4.38",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@ezstart/eslint-config": "workspace:*",
    "@ezstart/next-config": "workspace:*",
    "@ezstart/seo-config": "workspace:*",
    "@ezstart/tailwind-config": "workspace:*",
    "@ezstart/typescript-config": "workspace:*",
    "@types/node": "^20",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "deepmerge": "^4.3.1",
    "typescript": "^5.7.3"
  }
