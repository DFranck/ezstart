# EZPay Web Configuration Template
# Copy to .env.local for local development
# Copy to .env.production for Vercel deployment

# ======================
# API CONFIGURATION
# ======================
# ✅ MIGRATION NOTE: API URLs are now auto-configured via @ezstart/config
# You no longer need to set NEXT_PUBLIC_API_URL manually!
# The config package automatically detects environment and uses the correct URL:
#   - Local: http://localhost:5040
#   - Production: https://ezpay-api.up.railway.app
#
# If you need to override for testing, you can still set:
# NEXT_PUBLIC_API_URL=http://localhost:5040/api
#
# See packages/config/src/urls.ts for all configured URLs.

# ======================
# WEB URL CONFIGURATION
# ======================
# Current web app URL (for redirects and callbacks)
# Development: localhost
# Production: Vercel deployment URL

# ======================
# STRIPE CONFIGURATION
# ======================
# Stripe Publishable Key (client-side safe)
# Get from: https://dashboard.stripe.com/apikeys
# Test key for development (starts with pk_test_)
# Live key for production (starts with pk_live_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here

# ======================
# PRODUCTION EXAMPLES
# ======================
# Web (Vercel): https://ezpay.ezstart.xyz
# API (Railway): https://ezpay-api.up.railway.app
# Stripe Live Key: pk_live_...
