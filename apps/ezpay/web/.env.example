# ============================================================
# EZPay Web — .env.example
# ============================================================
# Per-app cascade (NO root layer):
#   local      → .env.local
#   staging    → .env.local ← .env.staging  (staging overrides)
#   production → .env.local ← .env.production (prod overrides)
# ============================================================

# ── Node / Deploy environment ───────────────────────────────
NODE_ENV=development
DEPLOY_ENV=local

# ── EZAuth publishable key (different per app) ────────────
NEXT_PUBLIC_EZAUTH_KEY=

# ── EZPay publishable key (scopes PayProvider to ezpay's own Application) ──
# Generate via: pnpm --filter api-ezpay seed:self-key
# Required for PayProvider to call /keys/config and resolve the applicationId
# (avoids the legacy appName-only path which warns about cross-app leak risk).
NEXT_PUBLIC_EZPAY_KEY=

# ── Pay docs sandbox publishable key (PAY_DOCS_DEMO_SANDBOX-001) ──────────
# Powers `/docs/pay/*` live previews (PricingPage, SubscriptionCard,
# DonationWall, PayAdminDashboard…). Sandbox-isolated subscriptions /
# payments / donations / invoices that reset every 24h. Hard quotas:
# 50 active subs / 200 payments per day / 100 donations per day.
#
# Generate via:
#   pnpm --filter api-ezauth seed:pay-docs-demo   # creates Application + keys (ezauth side)
#   pnpm --filter api-ezpay  seed:pay-docs-demo   # seeds sandbox plans/subs/payments (ezpay side)
NEXT_PUBLIC_EZPAY_DOCS_DEMO_KEY=

# ── EZPay API URL (for PayClient) ─────────────────────────
# Local dev: http://localhost:6130
# Production: https://api-ezpay.ezstart.app
NEXT_PUBLIC_EZPAY_API_URL=

# ── Stripe publishable key (client-side checkout) ─────────
# Starts with pk_test_ or pk_live_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Optional ──────────────────────────────────────────────
NEXT_PUBLIC_DEBUG=false
