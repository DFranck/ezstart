# EZPay Web Configuration Template
# Copy to .env.local for local development
# Copy to .env.production for Vercel deployment

# ======================
# API CONFIGURATION
# ======================
# EZPay API URL
# Development: Local API on port 5040
# Production: Railway deployed API
NEXT_PUBLIC_API_URL=http://localhost:5040/api

# ======================
# WEB URL CONFIGURATION
# ======================
# Current web app URL (for redirects and callbacks)
# Development: localhost
# Production: Vercel deployment URL
NEXT_PUBLIC_WEB_URL=http://localhost:5045

# ======================
# STRIPE CONFIGURATION
# ======================
# Stripe Publishable Key (client-side safe)
# Get from: https://dashboard.stripe.com/apikeys
# Test key for development (starts with pk_test_)
# Live key for production (starts with pk_live_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ======================
# PRODUCTION EXAMPLES
# ======================
# Vercel: https://ezstart-ezpay.vercel.app
# API Railway: https://ezpay-api.up.railway.app/api
# Stripe Live Key: pk_live_...
