# ============================================================
# EZPay Web — .env.example
# ============================================================
# Per-app cascade (NO root layer):
#   local      → .env.local
#   staging    → .env.local ← .env.staging  (staging overrides)
#   production → .env.local ← .env.production (prod overrides)
# ============================================================

# ── Node / Deploy environment ───────────────────────────────
NODE_ENV=development
DEPLOY_ENV=local

# ── EZAuth publishable key (different per app) ────────────
NEXT_PUBLIC_EZAUTH_KEY=

# ── EZPay publishable key (scopes PayProvider to ezpay's own Application) ──
# Generate via: pnpm --filter api-ezpay seed:self-key
# Required for PayProvider to call /keys/config and resolve the applicationId
# (avoids the legacy appName-only path which warns about cross-app leak risk).
NEXT_PUBLIC_EZPAY_KEY=

# ── Pay docs sandbox publishable key (PAY_DOCS_DEMO_SANDBOX-001) ──────────
# Powers `/docs/pay/*` live previews (PricingPage, SubscriptionCard,
# DonationWall, PayAdminDashboard…). Sandbox-isolated subscriptions /
# payments / donations / invoices that reset every 24h. Hard quotas:
# 50 active subs / 200 payments per day / 100 donations per day.
#
# Generate via:
#   pnpm --filter api-ezauth seed:pay-docs-demo   # creates Application + keys (ezauth side)
#   pnpm --filter api-ezpay  seed:pay-docs-demo   # seeds sandbox plans/subs/payments (ezpay side)
NEXT_PUBLIC_EZPAY_DOCS_DEMO_KEY=

# ── EZAuth API URL — OPTIONAL in production (Phase A1 ENV-DIET 2026-05-05) ─
# When unset, the SDK defaults to https://ezauth-api.ezstart.xyz. Required only
# for local/staging or self-hosted EZAuth deployments.
# Local dev: http://localhost:6110
# NEXT_PUBLIC_EZAUTH_API_URL=

# ── EZPay API URL — OPTIONAL in production (Phase A1 ENV-DIET 2026-05-05) ──
# When unset, the SDK defaults to https://ezpay-api.ezstart.xyz. Required only
# for local/staging or self-hosted EZPay deployments.
# Local dev: http://localhost:6130
NEXT_PUBLIC_EZPAY_API_URL=

# ── REMOVED — auto-derived from /keys/config since v1.x (Phase 3+A1 ENV-DIET) ──
# The auth-sdk AuthProvider auto-resolves webUrl from /keys/config.webUrl.
# NEXT_PUBLIC_EZAUTH_WEB_URL=

# ── Stripe publishable key (client-side checkout) ─────────
# Starts with pk_test_ or pk_live_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Optional ──────────────────────────────────────────────
NEXT_PUBLIC_DEBUG=false

# ── Sentry error tracking (OPTIONAL — leave commented to disable) ─
# Set ONLY in .env.staging (cascades to production via env.md cascade rule).
# NEVER set in .env.local — dev does not need Sentry. NEVER duplicate in
# .env.production — staging value already cascades. The Sentry project is
# shared staging+prod, environment is tagged via DEPLOY_ENV at runtime.
# Browser DSN — embedded in the client bundle at build time.
# NEXT_PUBLIC_SENTRY_DSN=
# Server DSN — used by Next.js server runtime (RSC + route handlers).
# Typically the SAME value as NEXT_PUBLIC_SENTRY_DSN.
# SENTRY_DSN=
# Source maps upload token — production-only, set in .env.production.
# Generate at https://sentry.io/settings/account/api/auth-tokens/ (project:releases).
# SENTRY_AUTH_TOKEN=
