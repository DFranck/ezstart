{
  "name": "api-ezpay",
  "version": "0.0.1",
  "type": "module",
  "description": "EZPay centralized payment service API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "start:prod": "pnpm build && node dist/index.js",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:self-key": "tsx src/scripts/seed-self-key.ts",
    "seed:plans": "tsx src/scripts/seed-ezpay-plans.ts",
    "configure:portal": "tsx src/scripts/configure-stripe-portal.ts",
    "migrate:connected-accounts-to-apps": "tsx src/scripts/migrate-connected-accounts-to-applications.ts",
    "migrate:plans-to-apps": "tsx src/scripts/migrate-plans-to-applications.ts"
  },
  "dependencies": {
    "@ezstart/api-core": "workspace:*",
    "@ezstart/auth-sdk": "workspace:*",
    "@ezstart/config": "workspace:*",
    "@ezstart/logger": "workspace:*",
    "@ezstart/pay-sdk": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.15.1",
    "stripe": "^22.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@ezstart/eslint-config": "workspace:*",
    "@ezstart/test-utils": "workspace:*",
    "@ezstart/typescript-config": "workspace:*",
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^4.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
