# ============================================================
# EZPay API — .env.example
# ============================================================

# ── Shared across ALL apps ────────────────────────────────
DEPLOY_ENV=local
MONGO_URL=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>/{app}?retryWrites=true&w=majority
JWT_SECRET=
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=ezstart

# ── Stripe (payment processing) ──────────────────────────
# Secret key (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=
# Webhook signing secret for /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Webhook signing secret for /api/webhooks/connect (Connect events)
STRIPE_CONNECT_WEBHOOK_SECRET=
# Publishable key mirror (for server-side introspection, e.g. live-mode detection)
STRIPE_PUBLISHABLE_KEY=

# ── Dev/test toggle (optional) ───────────────────────────
# Set to 'console' to force console-mode without calling Stripe.
# Only use in local dev; leave empty/commented in staging/production.
# PAYMENT_PROVIDER=console

# ── Sentry runtime DSN ───────────────────────────────────
SENTRY_DSN=

# ── Logger verbosity ─────────────────────────────────────
LOG_LEVEL=info

# ── EZPay → EZAuth service-to-service auth ───────────────
# Secret key (ez_sk_live_*) generated ONCE via the EZAuth dashboard by a
# superadmin. Used by the /api/keys create flow to verify `applicationId`
# against the ezauth source-of-truth. Leave blank for local dev if the
# caller's Bearer JWT is used; required in production.
EZPAY_SERVER_EZAUTH_KEY=

# Shared HMAC secret used to sign the ezpay → ezauth subscription webhook.
# Must be IDENTICAL on both sides. Generate via `openssl rand -hex 32`.
# Leave blank to disable cross-service subscription grants (dev-friendly).
EZAUTH_WEBHOOK_SECRET=

# ── Platform (dogfood) Stripe destination ────────────────
# Stripe account id of EZStart LLC used as the default destination for all
# first-party platform apps (ezauth, ezpay, ezstart, ezbill, green-pulse,
# fengshui, asc-tcd, gacha-analyzer) until each app onboards its own
# external Connect account. Get this value from
# https://dashboard.stripe.com/settings/account — format `acct_xxxxx`.
# Used by `pnpm --filter api-ezpay migrate:connected-accounts-to-apps` to
# seed platform ConnectedAccount rows. If unset, the seed step is skipped.
EZPAY_PLATFORM_STRIPE_ACCOUNT_ID=
