# EZPay API Configuration Template
# Copy to .env.local and fill with real values

# Server Configuration
PORT=5040
NODE_ENV=development

# Database Configuration
# Get your MongoDB connection string from MongoDB Atlas
MONGO_URL=mongodb://localhost:27017/ezpay

# Stripe Configuration
# Get your keys from Stripe Dashboard
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# URLs Configuration
WEB_URL=http://localhost:5045

# PayPal (optional)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
