# EZPay API Configuration Template
# Copy to .env.local for local development
# Copy to .env.production for Railway deployment

# ======================
# SERVER CONFIGURATION
# ======================
NODE_ENV=development

# ======================
# DATABASE CONFIGURATION
# ======================
# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017/ezpay

# ======================
# STRIPE CONFIGURATION
# ======================
# Get your keys from Stripe Dashboard: https://dashboard.stripe.com/apikeys
# Test keys for development (start with sk_test_ and pk_test_)
# Live keys for production (start with sk_live_ and pk_live_)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ======================
# URLs CONFIGURATION
# ======================
# ✅ MIGRATION NOTE: URLs, CORS origins, and Stripe redirects are now auto-configured via @ezstart/config
# You no longer need to set WEB_URL or ALLOWED_ORIGINS manually!
#
# Stripe redirect URLs are automatically determined based on the projectId sent in the payment request.
# For example:
# - projectId: 'ezbill' → Redirects to https://ezbill.ezstart.xyz/donate/success
# - projectId: 'tower-defense' → Redirects to https://tower-defense.ezstart.xyz/donate/success
#
# If you need a custom redirect URL, pass 'returnUrl' in the API request body.
#
# See packages/config/src/urls.ts for all configured app URLs.

# PORT is auto-detected from @ezstart/config (no need to set)

# ======================
# ERROR TRACKING (SENTRY)
# ======================
# Get your DSN from Sentry Dashboard: https://sentry.io/
# Project: ezpay-api
# Leave empty for development (errors will be logged to console)
# Required for production (error monitoring and alerting)
SENTRY_DSN=https://a1620fce9c2d0a0e0830aad701fbfd68@o4510227903152128.ingest.us.sentry.io/4510227932577792
