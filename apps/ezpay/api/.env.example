# EZPay API Configuration Template
# Copy to .env.local for local development
# Copy to .env.production for Railway deployment

# ======================
# SERVER CONFIGURATION
# ======================
PORT=5040
NODE_ENV=development

# ======================
# DATABASE CONFIGURATION
# ======================
# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017/ezpay

# ======================
# STRIPE CONFIGURATION
# ======================
# Get your keys from Stripe Dashboard: https://dashboard.stripe.com/apikeys
# Test keys for development (start with sk_test_ and pk_test_)
# Live keys for production (start with sk_live_ and pk_live_)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ======================
# URLs CONFIGURATION
# ======================
# Frontend URL for redirects and CORS
# Development: localhost
# Production: Vercel deployment URL
WEB_URL=http://localhost:5045
