# ============================================================
# EZStart Web — .env.example
# ============================================================
# Per-app cascade (NO root layer):
#   local      → .env.local
#   staging    → .env.local ← .env.staging  (staging overrides)
#   production → .env.local ← .env.production (prod overrides)
# ============================================================

# ── Node / Deploy environment ───────────────────────────────
NODE_ENV=development
DEPLOY_ENV=local

# ── EZAuth publishable key (per-app, different per web app) ──
# Format: ez_pk_live_<64-hex> — see .claude/rules/standard-saas-keys.md
# Generated via: pnpm --filter api-ezauth seed:consumer-app-keys
NEXT_PUBLIC_EZAUTH_KEY=

# ── Stripe publishable key (via pay-sdk) ──────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Server-side-only, read in /api/generate-cv route ──────
# Same GEMINI_API_KEY as ezstart/api — shared Gemini account
GEMINI_API_KEY=

# ── Optional ──────────────────────────────────────────────
NEXT_PUBLIC_DEBUG=false
