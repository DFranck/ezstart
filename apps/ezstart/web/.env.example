# EZStart Web Configuration Template
# Copy to .env.local and fill with real values

# Server Configuration
PORT=5005

# Google Gemini API (Required for AI-powered CV Generator feature)
# Get your API key from https://aistudio.google.com/app/apikey
# Free tier available with generous limits
GEMINI_API_KEY=your-gemini-api-key-here

# GitHub API (Required for dynamic Skills & Projects sections)
# Create a fine-grained token at https://github.com/settings/tokens
# Permissions needed: Contents (read), Metadata (read), Pull requests (read)
# Repository access: Public Repositories (read-only)
GITHUB_TOKEN=ghp_your-github-token-here
GITHUB_USERNAME=your-github-username