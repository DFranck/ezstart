# ============================================================
# EZStart Web — .env.example
# ============================================================
# Per-app cascade (NO root layer):
#   local      → .env.local
#   staging    → .env.local ← .env.staging  (staging overrides)
#   production → .env.local ← .env.production (prod overrides)
# ============================================================

# ── Node / Deploy environment ───────────────────────────────
NODE_ENV=development
DEPLOY_ENV=local

# ── EZAuth publishable key (per-app, different per web app) ──
# Format: ez_pk_live_<64-hex> — see .claude/rules/standard-saas-keys.md
# Generated via: pnpm --filter api-ezauth seed:consumer-app-keys
NEXT_PUBLIC_EZAUTH_KEY=

# ── EZAuth Application id (scopes ezpay queries to this app tenant) ──
# Run `pnpm --filter api-ezauth seed:consumer-app-keys` and copy the
# printed `applicationId`. Required by <PayProvider />.
NEXT_PUBLIC_EZAUTH_APP_ID=

# ── EZPay API + Web URLs ──────────────────────────────────
# Used by <PayProvider /> to call the ezpay API and build the "Get your key"
# CTA in graceful fallback cards. In dev leave the localhost defaults; in
# staging/production override in .env.staging / .env.production.
NEXT_PUBLIC_EZPAY_API_URL=http://localhost:6130
NEXT_PUBLIC_EZPAY_WEB_URL=http://localhost:6131

# ── Stripe publishable key (via pay-sdk) ──────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Server-side-only, read in /api/generate-cv route ──────
# Same GEMINI_API_KEY as ezstart/api — shared Gemini account
GEMINI_API_KEY=

# ── Optional ──────────────────────────────────────────────
NEXT_PUBLIC_DEBUG=false
