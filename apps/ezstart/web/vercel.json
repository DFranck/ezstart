{
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" != \"master\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" != \"staging\" ]; then exit 0; else npx turbo-ignore web-ezstart; fi",
  "buildCommand": "pnpm turbo build --filter=web-ezstart...",
  "outputDirectory": ".next",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "src/app/**/*": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/en",
      "statusCode": 302
    }
  ],
  "git": {
    "deploymentEnabled": {
      "master": true,
      "staging": true
    }
  }
}
