{
  "name": "api-ezstart",
  "version": "1.0.0",
  "type": "module",
  "description": "EZStart API - Monitoring and observability for @ezstart monorepo",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:e2e-tests": "tsx src/scripts/seed-e2e-test-definitions.ts",
    "seed:e2e-runs": "tsx src/scripts/seed-e2e-test-runs-from-markdown.ts",
    "migrate:e2e-env": "tsx src/scripts/migrate-e2e-runs-add-env.ts",
    "migrate:e2e-tier": "tsx src/scripts/migrate-e2e-runs-add-tier.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ezstart/ai-sdk": "workspace:*",
    "@ezstart/api-core": "workspace:*",
    "@ezstart/config": "workspace:*",
    "@ezstart/logger": "workspace:*",
    "@ezstart/monitoring": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "mongodb": "^6.12.0",
    "mongoose": "^8.19.1",
    "nodemailer": "^6.9.16",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@ezstart/eslint-config": "workspace:*",
    "@ezstart/test-utils": "workspace:*",
    "@ezstart/typescript-config": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mongoose": "^5.11.97",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.16",
    "dotenv": "^17.2.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.3"
  },
  "engines": {
    "node": "20.18.x",
    "pnpm": "10.12.x"
  }
}
