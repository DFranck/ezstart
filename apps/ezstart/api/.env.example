# Monitoring API Environment Variables
# Copy to .env.local and fill with real values

# Server
NODE_ENV=development

# MongoDB (for storing audit results and metrics)
MONGO_URL=mongodb://localhost:27017/ezstart

# CORS (auto-configured via @ezstart/config)
# ALLOWED_ORIGINS is automatically set based on environment

# Monitoring Configuration
# Strategy:
# - Railway APIs (EZAuth, EZPay, EZBill, EZStart, GreenPulse): Check for monitoring and uptime
# - Vercel Web Apps: Check for uptime
#
# Railway FREE tier: Check every 10 minutes for optimal monitoring
# Cost: Minimal (~$0.02-0.05/month for health checks)
HEALTH_CHECK_INTERVAL=600000  # 10 minutes (optimal for Render + low Railway cost)
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3

# ======================
# ERROR TRACKING (SENTRY)
# ======================
# Get your DSN from Sentry Dashboard: https://sentry.io/
# Project: monitoring-api (ezmonitoring-api)
# Leave empty for development (errors will be logged to console)
# Required for production (error monitoring and alerting)
SENTRY_DSN=your-sentry-dsn-here

# ======================
# SENTRY API INTEGRATION
# ======================
# Auth Token for reading Sentry issues/events via REST API
# Create at: https://sentry.io/settings/account/api/auth-tokens/
# Required scopes: org:read, project:read, event:read
# Used to fetch errors from all @ezstart projects into monitoring dashboard
SENTRY_AUTH_TOKEN=your-sentry-auth-token-here
SENTRY_ORG_SLUG=ezstart

# ======================
# ALERTING CONFIGURATION (OPTIONAL)
# ======================
# Email alerts
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_FROM=monitoring@ezstart.xyz
ALERT_EMAIL_TO=your-email@example.com
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=your-smtp-user-here
ALERT_SMTP_PASS=your-smtp-password-here

# Slack alerts
ALERT_SLACK_ENABLED=false
ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/your-webhook-url-here

# External Services (optional)
# DATADOG_API_KEY=

# PORT is auto-detected from @ezstart/config (no need to set)

# ======================
# PROVIDER STATUS AGGREGATOR (admin Services tab)
# ======================
# Powers the /api/admin/services endpoint used by the admin "Services" tab.
# Each provider is optional — missing tokens just mark that provider as "unknown"
# in the dashboard without breaking the aggregator. Fill what you need.

# Vercel — https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Railway — https://railway.app/account/tokens
RAILWAY_TOKEN=

# MongoDB Atlas — https://cloud.mongodb.com/ (Organization > Access Manager > API Keys)
MONGODB_ATLAS_PUBLIC_KEY=
MONGODB_ATLAS_PRIVATE_KEY=
MONGODB_ATLAS_PROJECT_ID=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Sentry — already defined above (SENTRY_AUTH_TOKEN, SENTRY_ORG_SLUG)
# The aggregator reuses the same values, no duplication needed.

# AI providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# GitHub — https://github.com/settings/tokens (classic, scopes: repo, read:user)
GITHUB_TOKEN=
GITHUB_USERNAME=
