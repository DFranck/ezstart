# ============================================================
# EZStart API — .env.example (services dashboard / control plane)
# ============================================================
# The ezstart API reads many external provider credentials to surface
# status / usage across the monorepo.
# Per-app cascade (NO root layer):
#   local      → .env.local
#   staging    → .env.local ← .env.staging  (staging overrides)
#   production → .env.local ← .env.production (prod overrides)
# ============================================================

# ── Node / Deploy environment ───────────────────────────────
NODE_ENV=development
DEPLOY_ENV=local

# ── MongoDB (templated — {app} resolved via getMongoUrl) ─────
MONGO_URL=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>/{app}?retryWrites=true&w=majority

# ── JWT — SSO interop, MUST match other apps ────────────────
JWT_SECRET=<GENERATE_SECURE_64_BYTE>

# ── AI providers (status + usage queries) ─────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_ADMIN_KEY=
ANTHROPIC_API_KEY=
# OPTIONAL: console.anthropic.com → Settings → Admin Keys (Workspace Admin role).
# Empty = graceful fallback (admin features disabled).
# ANTHROPIC_ADMIN_KEY=

# ── Email (Resend) ────────────────────────────────────────
# Regular transactional key (same across ezauth/ezbill/ezstart)
RESEND_API_KEY=
# Admin-scope key for Resend dashboard introspection (ezstart only)
RESEND_FULL_ACCESS_API_KEY=

# ── Stripe (status only — ezpay owns real transactions) ──
STRIPE_SECRET_KEY=

# ── MongoDB Atlas admin API (cluster metrics) ────────────
MONGODB_ATLAS_PUBLIC_KEY=
MONGODB_ATLAS_PRIVATE_KEY=
MONGODB_ATLAS_PROJECT_ID=

# ── Infra CLIs / tokens ───────────────────────────────────
GITHUB_TOKEN=
GITHUB_USERNAME=
VERCEL_TOKEN=
# Vercel team identifier (used by VercelProvider) — required for accurate team scoping
VERCEL_TEAM_ID=
RAILWAY_TOKEN=

# ── Health checks (runtime tuning) ───────────────────────
HEALTH_CHECK_INTERVAL=600000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3

# ── Logger verbosity ─────────────────────────────────────
LOG_LEVEL=info

# ── Alerting (currently stubs — feature not wired) ───────
# ALERT_EMAIL_ENABLED=false
# ALERT_EMAIL_FROM=monitoring@ezstart.xyz
# ALERT_EMAIL_TO=
# ALERT_SMTP_HOST=smtp.gmail.com
# ALERT_SMTP_PORT=587
# ALERT_SMTP_USER=
# ALERT_SMTP_PASS=
# ALERT_SLACK_ENABLED=false
# ALERT_SLACK_WEBHOOK=
