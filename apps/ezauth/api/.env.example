# ============================================================
# EZAuth API — .env.example (TEMPLATE, committed, no values)
# ============================================================
# Copy this file to apps/ezauth/api/.env.local and fill the values.
# Production values go in Railway dashboard (never committed).
#
# Per-app cascade (NO root layer):
#   local      → .env.local
#   staging    → .env.local ← .env.staging  (staging overrides)
#   production → .env.local ← .env.production (prod overrides)
#
# Bootstrap:
#   Run `pnpm --filter api-ezauth seed:self-key` once per environment to
#   bootstrap the ezauth self-key (copies into web/.env.local as
#   NEXT_PUBLIC_EZAUTH_KEY).
# ============================================================

# ── Node / Deploy environment ───────────────────────────────
NODE_ENV=development
DEPLOY_ENV=local

# ── MongoDB — templated per-app. {app} resolved at boot via getMongoUrl('ezauth') ──
MONGO_URL=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>/{app}?retryWrites=true&w=majority

# ── JWT — SSO signing key, MUST be IDENTICAL across every app ──
# Generate with: openssl rand -base64 64
JWT_SECRET=<GENERATE_SECURE_64_BYTE>

# ── EZAuth-specific (required) ───────────────────────────────
# Min 16 chars. Secret used to sign OAuth CSRF state.
OAUTH_STATE_SECRET=

# ── EZAuth-specific (optional, with defaults) ────────────────
# AES-256 encryption key for OAuth token storage
OAUTH_ENCRYPTION_KEY=
# Access token TTL (e.g. 15m, 1h, 24h). Default 15m.
ACCESS_TOKEN_EXPIRES_IN=24h
# Cookie domain — controls which hosts/ports the auth cookie is sent to.
# Inherited from the root .env.example (shared var). Override here only if
# this app needs a different scope than the rest of the monorepo.
#   dev (cross-port SSR on 6110 API + 6111 Web): Domain=localhost
#   prod (cross-subdomain auth on *.ezstart.xyz): Domain=.ezstart.xyz
# See `.claude/rules/env.md` §7 for the rationale + helper pattern.
COOKIE_DOMAIN=localhost
# Fail SSO if email unverified — default false for back-compat
REQUIRE_VERIFIED_EMAIL_FOR_SSO=false

# ── Google OAuth (optional — required to enable Google sign-in) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:6110/api/auth/google/callback
# Comma-separated allow-list of redirect origins for /sso/authorize
SSO_ALLOWED_REDIRECTS=http://localhost:6111,http://localhost:6121,http://localhost:6131,http://localhost:6141,http://localhost:6151,http://localhost:6161,http://localhost:6171

# ── Email (transactional sends) ──────────────────────────────
# Resend API key — reused across ezauth/ezbill/ezstart
RESEND_API_KEY=
# Sender address (e.g. 'EZAuth <noreply@ezstart.xyz>'). Optional — defaults to 'EZAuth <noreply@ezstart.xyz>'.
# EMAIL_FROM=EZAuth <noreply@ezstart.xyz>

# ── EZPay → EZAuth subscription webhook receiver ─────────────
# Per-Application HMAC secret (Stripe `whsec_*` pattern). Stored on the
# Application document in MongoDB (`Application.webhookSecret`). The
# receiver at POST /api/subscriptions/webhook loads it dynamically from
# the targeted Application — there is NO shared env var to set anymore.
#
# Bootstrap workflow:
#   1. Run `pnpm --filter api-ezauth seed:webhook-secrets` to backfill
#      every existing Application with a fresh whsec_<hex> value.
#   2. New Applications auto-receive a secret on creation.
#   3. Reveal / rotate via the dashboard's Application detail "Webhooks"
#      tab (uses the reveal-once UX from @ezstart/auth-sdk).
#
# Related caller side (ezpay):
#   - EZPAY_SERVER_EZAUTH_KEY in apps/ezpay/api/.env.local must point to an
#     EZAuth API key with scope: 'admin' (ez_sk_live_*) so ezpay can both
#     POST to this webhook AND fetch the Application's secret via
#     `getApplication(id, { includeWebhookSecret: true })`. Without it the
#     cross-service grant silently no-ops and `user.appRoles` stays empty.

# ── Logger verbosity (consumed by @ezstart/logger) ───────────
# Optional: trace | debug | info | warn | error. Default 'info'.
LOG_LEVEL=info

# ── Cloudflare Turnstile captcha (OPTIONAL — leave commented to disable) ─
# Server-side secret key used to verify tokens via Cloudflare's
# /siteverify endpoint on /auth/register, /auth/forgot-password, /auth/login.
# When unset the entire captcha integration is a no-op
# (`verifyTurnstileToken` returns success automatically). To enable:
#   1. Create a Turnstile widget at https://dash.cloudflare.com → Turnstile
#   2. Set this var here
#   3. Set NEXT_PUBLIC_TURNSTILE_SITE_KEY in apps/ezauth/web/.env.local
#   4. Pass `turnstileSiteKey={process.env.NEXT_PUBLIC_TURNSTILE_SITE_KEY}`
#      to <SignInForm> / <SignUpForm> / <ForgotPasswordForm> (or wrappers).
# TURNSTILE_SECRET_KEY=

# ── Sentry error tracking (OPTIONAL — leave commented to disable) ─
# Backend DSN. When unset, `initSentry()` is a no-op and no events are sent.
# Get one from https://sentry.io after creating an org + project. Uses
# `@sentry/node-core` with ZERO auto-integrations (avoids the 2026-04-25
# OTEL/Express CORS incident on Railway).
# SENTRY_DSN=
