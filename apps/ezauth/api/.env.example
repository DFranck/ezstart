# EZAuth API Configuration Template
# Copy to .env.local for local development
# Copy to .env.production for Railway deployment

# ======================
# SERVER CONFIGURATION
# ======================
NODE_ENV=development

# ======================
# DATABASE CONFIGURATION
# ======================
# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017/ezauth

# ======================
# JWT CONFIGURATION
# ======================
# Secret key for signing JWTs — must match across all APIs that verify tokens (EZBill, GreenPulse, etc.)
# Use a strong random string (e.g. openssl rand -hex 64)
JWT_SECRET=your-jwt-secret-here-change-in-production

# Secret key for signing short-lived OAuth state tokens (CSRF protection on Google callback).
# Use a strong random string (e.g. openssl rand -hex 32)
OAUTH_STATE_SECRET=your-oauth-state-secret-here-change-in-production

# ======================
# COOKIE CONFIGURATION
# ======================
# Parent domain for auth cookies in production (enables cross-subdomain SSO).
# Leave empty in development (host-only cookies on localhost).
# Example in prod: .ezstart.xyz
COOKIE_DOMAIN=

# ======================
# CORS CONFIGURATION
# ======================
# ✅ MIGRATION NOTE: CORS origins are now auto-configured via @ezstart/config
# You no longer need to set ALLOWED_ORIGINS manually!
# The config package automatically includes all apps that use EZAuth.
#
# If you need custom origins for testing, you can still add them:
# ALLOWED_ORIGINS=http://localhost:6111,http://localhost:6121,http://localhost:6131,http://localhost:6131,http://localhost:6141,http://localhost:6151
#
# See packages/config/src/cors.ts for the full list of auto-configured origins.

# PORT is auto-detected from @ezstart/config (no need to set)

# ======================
# OAUTH ENCRYPTION KEY
# ======================
# Dedicated AES-256 key for encrypting OAuth tokens at rest.
# Use a strong random string (e.g. openssl rand -hex 32)
# Falls back to JWT_SECRET if not set (not recommended in production).
OAUTH_ENCRYPTION_KEY=your-oauth-encryption-key-here

# ======================
# OAUTH CONFIGURATION (OPTIONAL)
# ======================
# Google OAuth 2.0 Credentials
# Get from: https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID
# 2. Add authorized redirect URI: http://localhost:6110/api/auth/google/callback
# 3. Copy Client ID and Client Secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:6110/api/auth/google/callback

# GitHub OAuth (TODO)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:6110/api/auth/github/callback

# ======================
# ERROR TRACKING (SENTRY)
# ======================
# Get your DSN from Sentry Dashboard: https://sentry.io/
# Project: ezauth-api
# Leave empty for development (errors will be logged to console)
# Required for production (error monitoring and alerting)
SENTRY_DSN=your-sentry-dsn-here

# ======================
# SSO HANDOFF (cross-domain)
# ======================
# Comma-separated list of allowed redirect origins for /api/auth/sso/authorize.
# Any redirectUri passed to /sso/authorize must have its origin in this list.
# Pathname is NOT restricted (validated as a same-origin URL only).
# Dev example includes the local ezauth web + any local app using SSO.
SSO_ALLOWED_REDIRECTS=https://ezauth.ezstart.xyz,http://localhost:6111

# Require email verification before issuing SSO handoff codes / exchanging them.
# Leave false until existing production users have been migrated (i.e. had a chance
# to verify). Set to true afterwards to enforce verified-email on cross-app SSO.
REQUIRE_VERIFIED_EMAIL_FOR_SSO=false  # set to true after production users are migrated

# ======================
# EMAIL SERVICE
# ======================
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=EZAuth <noreply@ezstart.xyz>
