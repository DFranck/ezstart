# EZAuth API Configuration Template
# Copy to .env.local and fill with real values

# Server Configuration
PORT=5010
NODE_ENV=development

# Database Configuration
# Get your MongoDB connection string from MongoDB Atlas
MONGO_URL=mongodb://localhost:27017/ezauth

# JWT Configuration
# Generate a secure random string for production
JWT_SECRET=your-secure-jwt-secret-here

# CORS Configuration
# Add all allowed web app origins (development ports)
ALLOWED_ORIGINS=http://localhost:5015,http://localhost:5025,http://localhost:5035,http://localhost:5045,http://localhost:5055,http://localhost:5065