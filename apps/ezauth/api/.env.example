# EZAuth API Configuration Template
# Copy to .env.local for local development
# Copy to .env.production for Railway deployment

# ======================
# SERVER CONFIGURATION
# ======================
NODE_ENV=development

# ======================
# DATABASE CONFIGURATION
# ======================
# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017/ezauth

# ======================
# JWT CONFIGURATION
# ======================
# 🔐 RSA Key Pair for JWT Signing (Asymmetric)
# The API signs JWTs with the PRIVATE key
# Web apps validate JWTs with the PUBLIC key
#
# Generate new keys:
#   openssl genrsa -out jwt-private.pem 2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
#
# Then set in .env.local (dev) or .env.production (prod):
#   JWT_PRIVATE_KEY="$(cat jwt-private.pem)"
#
# ⚠️ CRITICAL: Keep private key SECRET! Never commit to git!
# ✅ Share PUBLIC key with web apps (NEXT_PUBLIC_EZAUTH_JWT_PUBLIC_KEY)
#
JWT_PRIVATE_KEY=your-rsa-private-key-here-generate-with-openssl

# ======================
# CORS CONFIGURATION
# ======================
# ✅ MIGRATION NOTE: CORS origins are now auto-configured via @ezstart/config
# You no longer need to set ALLOWED_ORIGINS manually!
# The config package automatically includes all apps that use EZAuth.
#
# If you need custom origins for testing, you can still add them:
# ALLOWED_ORIGINS=http://localhost:5015,http://localhost:5025,http://localhost:5035,http://localhost:5045,http://localhost:5055,http://localhost:5065
#
# See packages/config/src/cors.ts for the full list of auto-configured origins.

# PORT is auto-detected from @ezstart/config (no need to set)

# ======================
# OAUTH CONFIGURATION (OPTIONAL)
# ======================
# Google OAuth 2.0 Credentials
# Get from: https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID
# 2. Add authorized redirect URI: http://localhost:5010/api/auth/google/callback
# 3. Copy Client ID and Client Secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5010/api/auth/google/callback

# GitHub OAuth (TODO)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:5010/api/auth/github/callback

# ======================
# ERROR TRACKING (SENTRY)
# ======================
# Get your DSN from Sentry Dashboard: https://sentry.io/
# Project: ezauth-api
# Leave empty for development (errors will be logged to console)
# Required for production (error monitoring and alerting)
SENTRY_DSN=your-sentry-dsn-here
