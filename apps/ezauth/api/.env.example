# EZAuth API Configuration Template
# Copy to .env.local for local development
# Copy to .env.production for Railway deployment

# ======================
# SERVER CONFIGURATION
# ======================
NODE_ENV=development

# ======================
# DATABASE CONFIGURATION
# ======================
# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017/ezauth

# ======================
# JWT CONFIGURATION
# ======================
# Generate a secure random string for production
# Use: openssl rand -base64 32
JWT_SECRET=your-secure-jwt-secret-here-change-in-production

# ======================
# CORS CONFIGURATION
# ======================
# ✅ MIGRATION NOTE: CORS origins are now auto-configured via @ezstart/config
# You no longer need to set ALLOWED_ORIGINS manually!
# The config package automatically includes all apps that use EZAuth.
#
# If you need custom origins for testing, you can still add them:
# ALLOWED_ORIGINS=http://localhost:5015,http://localhost:5025,http://localhost:5035,http://localhost:5045,http://localhost:5055,http://localhost:5065
#
# See packages/config/src/cors.ts for the full list of auto-configured origins.

# PORT is auto-detected from @ezstart/config (no need to set)
