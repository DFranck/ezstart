# EZAuth API - TEST Environment
# This file is used ONLY for running tests with vitest
# It ensures tests NEVER touch production MongoDB

# CRITICAL: Force localhost MongoDB for tests
# MongoMemoryServer will override this, but it's a safety net
MONGO_URL=mongodb://localhost:27017/ezauth-test

# Test environment
NODE_ENV=test

# Dummy secrets for tests (not used, but required by app)
JWT_SECRET=test-secret-not-used
