# ============================================================
# EZAuth Web — .env.example
# ============================================================
# NEXT_PUBLIC_* vars are embedded in the client bundle at build time.
# Set non-public vars in Vercel env settings for prod.
# Per-app cascade (NO root layer):
#   local      → .env.local
#   staging    → .env.local ← .env.staging  (staging overrides)
#   production → .env.local ← .env.production (prod overrides)
# ============================================================

# ── Node / Deploy environment ───────────────────────────────
NODE_ENV=development
DEPLOY_ENV=local

# ── EZAuth publishable key (per-app — DIFFERENT value per web app) ──
# Public auth SDK key for THIS web app. Create one in the EZAuth admin
# dashboard. Each web app uses a distinct key to scope access.
NEXT_PUBLIC_EZAUTH_KEY=

# ── EZAuth API URL (used by AuthProvider — explicit to avoid SSR auto-detect fail) ──
NEXT_PUBLIC_EZAUTH_API_URL=http://localhost:6110

# ── EZPay API URL (used by PayProvider for the landing PricingPage) ──
NEXT_PUBLIC_EZPAY_API_URL=http://localhost:6130

# ── EZPay publishable key (so the PayProvider in ezauth web can call ──
# /keys/config on ezpay and avoid the "Dev Mode — no API key" fallback
# rendered by pay-sdk components when no key is configured). Generate via:
#   pnpm --filter api-ezpay seed:self-key
NEXT_PUBLIC_EZPAY_KEY=

# ── EZAuth application id (used by the landing PricingPage) ──
# Scopes the plans shown on the public landing pricing section.
NEXT_PUBLIC_EZAUTH_APP_ID=

# ── Cloudflare Turnstile captcha (OPTIONAL — leave commented to disable) ─
# Public site key for the Turnstile widget shipped with @ezstart/auth-sdk.
# When set, pass via `turnstileSiteKey` to <SignInForm> / <SignUpForm> /
# <ForgotPasswordForm>. Get a key at https://dash.cloudflare.com → Turnstile.
# Pair with TURNSTILE_SECRET_KEY in apps/ezauth/api/.env.local — both must be
# set for the captcha to actually verify, otherwise it's a no-op.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Optional debug toggle (client-side) ───────────────────
NEXT_PUBLIC_DEBUG=false

# ── Sentry error tracking (OPTIONAL — leave commented to disable) ─
# Browser DSN — embedded in the client bundle at build time.
# NEXT_PUBLIC_SENTRY_DSN=
# Server DSN — used by Next.js server runtime (RSC + route handlers).
# Typically the SAME value as NEXT_PUBLIC_SENTRY_DSN.
# SENTRY_DSN=
# Source maps upload token (production deploys ONLY). Generate at
# https://sentry.io/settings/account/api/auth-tokens/ with `project:releases`.
# SENTRY_AUTH_TOKEN=
