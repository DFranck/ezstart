# EZAuth Web Configuration Template
# Copy to .env.local for local development
# Copy to .env.production for Vercel deployment

# ======================
# SERVER CONFIGURATION
# ======================
# Development port (not used in production Vercel)
PORT=5015

# ======================
# API CONFIGURATION
# ======================
# EZAuth API URL
# Development: Local API on port 5010
# Production: Railway deployed API

# ======================
# PRODUCTION EXAMPLES
# ======================
# Web (Vercel): https://ezauth.ezstart.xyz
# API (Railway): https://ezauth-api.up.railway.app
