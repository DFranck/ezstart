# EZAuth Web Configuration Template
# Copy to .env.local and fill with real values

# Server Configuration  
PORT=5015

# External Services
# Usually points to your deployed EZAuth API
NEXT_PUBLIC_EZAUTH_API_URL=http://localhost:5010/api/auth

# Production examples:
# NEXT_PUBLIC_EZAUTH_API_URL=https://your-ezauth-api.com/api/auth