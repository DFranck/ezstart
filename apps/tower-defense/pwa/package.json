{
  "name": "web-tower-defense",
  "description": "Competitive multiplayer Tower Defense game. Combines RNG shop mechanics (auto-battler style), dynamic pathing with free tower placement, and unit-sending PvP (old school Warcraft TD). Players build, defend, and attack in a real-time loop with evolving income. High replayability and skill-based late game.",
  "version": "1.0.0",
  "type": "module",
  "private": false,
  "scripts": {
    "dev": "next dev --turbopack -p 4200",
    "build": "node scripts/generate-pwa-icons.js && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "generate-icons": "node scripts/generate-pwa-icons.js",
    "deploy": "./scripts/deploy.sh",
    "deploy:vercel": "vercel --prod"
  },
  "dependencies": {
    "@ezstart/auth-sdk": "workspace:*",
    "@ezstart/types": "workspace:*",
    "@ezstart/ui": "workspace:*",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@tanstack/react-virtual": "^3.13.8",
    "@tower-defense/config": "workspace:*",
    "@tower-defense/types": "workspace:*",
    "@tower-defense/utils": "workspace:*",
    "deepmerge": "^4.3.1",
    "framer-motion": "^12.10.1",
    "next": "^15.5.2",
    "next-intl": "^4.1.0",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.4.6",
    "pathfinding": "^0.4.18",
    "pixi.js": "^7.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.3",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/socket.io-client": "^3.0.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "sharp": "^0.34.3",
    "typescript": "^5.7.3"
  }
}
