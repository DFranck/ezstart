# Tower Defense API Configuration Template
# Copy to .env.local and fill with real values

# Server Configuration
NODE_ENV=development

# Database Configuration
# Get your MongoDB connection string from MongoDB Atlas
MONGO_URL=mongodb://localhost:27017/towerdefense

# ======================
# ERROR TRACKING (SENTRY)
# ======================
# Get your DSN from Sentry Dashboard: https://sentry.io/
# Project: tower-defense-api
# Leave empty for development (errors will be logged to console)
# Required for production (error monitoring and alerting)
SENTRY_DSN=your-sentry-dsn-here

# PORT is auto-detected from @ezstart/config (no need to set)
