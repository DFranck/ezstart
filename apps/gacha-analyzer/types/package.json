{
  "name": "@gacha-analyzer/types",
  "version": "0.1.0",
  "description": "Types for gacha-analyzer application",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@ezstart/typescript-config": "workspace:*",
    "typescript": "^5.7.3"
  }
}
