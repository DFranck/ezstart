{
  "name": "api-gacha-analyzer",
  "version": "0.0.1",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts < NUL",
    "prebuild": "pnpm --filter @ezstart/config build && pnpm --filter @ezstart/express-core build && pnpm --filter @gacha-analyzer/types build",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "start:prod": "pnpm build && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ezstart/config": "workspace:*",
    "@ezstart/express-core": "workspace:*",
    "@ezstart/logger": "workspace:*",
    "@ezstart/ocr-sdk": "workspace:*",
    "@gacha-analyzer/types": "workspace:*",
    "@google/generative-ai": "^0.24.1",
    "express": "^4.19.2",
    "mongoose": "^8.15.1",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.34.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@ezstart/typescript-config": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.19.9",
    "tsx": "^4.20.0",
    "typescript": "^5.7.3",
    "vitest": "^4.0.3"
  }
}
