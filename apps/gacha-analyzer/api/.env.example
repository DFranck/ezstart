# Server Configuration
NODE_ENV=development

# Database Configuration
# Dedicated database for Gacha Analyzer
# Uses @ezstart/express-core connectToMongo() — falls back to localhost if not set
MONGO_URL=mongodb://localhost:27017/game-analyzer

# ======================
# ERROR TRACKING (SENTRY)
# ======================
# Get your DSN from Sentry Dashboard: https://sentry.io/
# Project: gacha-analyzer-api
# Leave empty for development (errors will be logged to console)
# Required for production (error monitoring and alerting)
SENTRY_DSN=your-sentry-dsn-here

# ======================
# GEMINI VISION (OCR Fallback)
# ======================
# Used as fallback when Tesseract confidence is low
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ======================
# JWT AUTHENTICATION
# ======================
# Must match EZAuth's JWT_SECRET (shared across all APIs)
JWT_SECRET=your-jwt-secret-here-must-match-ezauth

# PORT is auto-detected from @ezstart/config (no need to set)
