# ============================================================
# Gacha Analyzer API — .env.example
# ============================================================

# ── Shared across ALL apps ────────────────────────────────
DEPLOY_ENV=local
MONGO_URL=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>/{app}?retryWrites=true&w=majority
JWT_SECRET=
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=ezstart

# ── AI (OCR + gacha rate analysis) ────────────────────────
GEMINI_API_KEY=

# ── Sentry runtime DSN (create this project in Sentry) ───
# Set directly OR via SENTRY_DSN_GACHA_ANALYZER (legacy suffix pattern)
SENTRY_DSN=

# ── Logger verbosity ─────────────────────────────────────
LOG_LEVEL=info
