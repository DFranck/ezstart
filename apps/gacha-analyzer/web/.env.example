# ============================================================
# Gacha Analyzer Web — .env.example
# ============================================================
# Note: gacha-analyzer is hosted on a non-*.ezstart.xyz domain, so it needs
# the JWT public key client-side for local token verification.
# ============================================================

# ── Shared ────────────────────────────────────────────────
DEPLOY_ENV=local
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=ezstart

# ── EZAuth publishable key (per-app) ──────────────────────
# Format: ez_pk_live_<64-hex> — see .claude/rules/standard-saas-keys.md
# Generated via: pnpm --filter api-ezauth seed:consumer-app-keys
NEXT_PUBLIC_EZAUTH_KEY=

# ── JWT public key for cross-domain token verify ──────────
# Used because gacha-analyzer is NOT on *.ezstart.xyz
NEXT_PUBLIC_EZAUTH_JWT_PUBLIC_KEY=

# ── API URL for Next.js rewrites ──────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:6170/api

# ── Optional ──────────────────────────────────────────────
NEXT_PUBLIC_DEBUG=false
