# Server Configuration
PORT=5070
NODE_ENV=development

# Database Configuration
# Same MongoDB instance, but dedicated database for GreenPulse
MONGO_URL=mongodb://localhost:27017/greenpulse

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# ESG SaaS Integration
ESG_CLIENT_ID=your-esg-client-id
ESG_CLIENT_SECRET=your-esg-client-secret
ESG_BASE_URL=https://api.esg-saas.example

# Webhook Security
WEBHOOK_SIGNING_SECRET=your-webhook-signing-secret-here

# JWT Authentication (if needed)
JWT_SECRET=your-jwt-secret-here

# File Upload Configuration
MAX_FILE_SIZE=52428800
UPLOAD_DIR=uploads

# CORS Configuration
CORS_ORIGIN=http://localhost:5075

# Logging
LOG_LEVEL=info