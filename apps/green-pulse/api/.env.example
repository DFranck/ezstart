# ============================================================
# GreenPulse API — .env.example
# ============================================================

# ── Shared across ALL apps ────────────────────────────────
DEPLOY_ENV=local
MONGO_URL=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>/{app}?retryWrites=true&w=majority
JWT_SECRET=
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=ezstart

# ── AI (ESG advisor) ──────────────────────────────────────
GEMINI_API_KEY=

# ── Logging verbosity (consumed by @ezstart/logger) ──────
LOG_LEVEL=info

# ── Sentry runtime DSN ───────────────────────────────────
SENTRY_DSN=

# ── Stubs: ESG SaaS provider (pending wire-up) ───────────
# Code currently has empty-string fallbacks — safe to leave blank until
# the real ESG provider is integrated.
# ESG_BASE_URL=https://api.esg-saas.example
# ESG_CLIENT_ID=
# ESG_CLIENT_SECRET=
# WEBHOOK_SIGNING_SECRET=
