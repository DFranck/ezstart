# Server Configuration
NODE_ENV=development

# Database Configuration
# Same MongoDB instance, but dedicated database for GreenPulse
MONGO_URL=mongodb://localhost:27017/greenpulse

# AI API Configuration
# Get your free Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI (DEPRECATED - use Gemini instead)
# OPENAI_API_KEY=sk-your-openai-api-key-here

# ESG SaaS Integration
ESG_CLIENT_ID=your-esg-client-id
ESG_CLIENT_SECRET=your-esg-client-secret
ESG_BASE_URL=https://api.esg-saas.example

# Webhook Security
WEBHOOK_SIGNING_SECRET=your-webhook-signing-secret-here

# JWT Authentication (if needed)
JWT_SECRET=your-jwt-secret-here

# File Upload Configuration
MAX_FILE_SIZE=52428800
UPLOAD_DIR=uploads

# CORS Configuration
CORS_ORIGIN=http://localhost:5075

# Logging
LOG_LEVEL=info

# ======================
# ERROR TRACKING (SENTRY)
# ======================
# Get your DSN from Sentry Dashboard: https://sentry.io/
# Project: greenpulse-api
# Leave empty for development (errors will be logged to console)
# Required for production (error monitoring and alerting)
SENTRY_DSN=your-sentry-dsn-here

# PORT is auto-detected from @ezstart/config (no need to set)
