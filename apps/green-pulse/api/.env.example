# ============================================================
# GreenPulse API — .env.example
# ============================================================
# Per-app cascade (NO root layer):
#   local      → .env.local
#   staging    → .env.local ← .env.staging  (staging overrides)
#   production → .env.local ← .env.production (prod overrides)
# ============================================================

# ── Node / Deploy environment ───────────────────────────────
NODE_ENV=development
DEPLOY_ENV=local

# ── MongoDB (templated — {app} resolved via getMongoUrl) ─────
MONGO_URL=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>/{app}?retryWrites=true&w=majority

# ── JWT — SSO interop, MUST match other apps ────────────────
JWT_SECRET=<GENERATE_SECURE_64_BYTE>

# ── AI (ESG advisor) ──────────────────────────────────────
GEMINI_API_KEY=

# ── Logging verbosity (consumed by @ezstart/logger) ──────
LOG_LEVEL=info

# ── Stubs: ESG SaaS provider (pending wire-up) ───────────
# Code currently has empty-string fallbacks — safe to leave blank until
# the real ESG provider is integrated.
# ESG_BASE_URL=https://api.esg-saas.example
# ESG_CLIENT_ID=
# ESG_CLIENT_SECRET=
# WEBHOOK_SIGNING_SECRET=

# ── ESG webhook legacy bare-HMAC gate (hacker A1b.5 — V4) ─────
# Toggle the legacy bare-HMAC signature format (no replay protection).
# Defaults:
#   • production / staging (DEPLOY_ENV != local OR NODE_ENV=production) → OFF
#   • local dev (DEPLOY_ENV=local or unset)                             → ON
# Set explicitly to 'true' to grant integrators a transition window in
# staging/production, or to 'false' in local dev to validate the cutover.
# Sunset date for the legacy format: 2026-12-01. After that, this gate
# will be removed and the v1 timestamped format (t=<unix>,v1=<hex>) will
# be the only accepted signature.
# ESG_LEGACY_HMAC_ENABLED=false
