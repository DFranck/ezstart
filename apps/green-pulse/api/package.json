{
  "name": "api-green-pulse",
  "version": "0.0.1",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "pnpm --filter @ezstart/config build && pnpm --filter @ezstart/api-core build && pnpm --filter @ezstart/express-core build && pnpm --filter @green-pulse/types build",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "start:prod": "pnpm build && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.0.0",
    "@ezstart/ai-sdk": "workspace:*",
    "@ezstart/api-core": "workspace:*",
    "@ezstart/config": "workspace:*",
    "@ezstart/logger": "workspace:*",
    "@google/generative-ai": "^0.24.1",
    "@green-pulse/types": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.19.2",
    "mongoose": "^8.15.1",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.78.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@ezstart/eslint-config": "workspace:*",
    "@ezstart/typescript-config": "workspace:*",
    "@types/cors": "^2.8.18",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.19.9",
    "tsx": "^4.20.0",
    "typescript": "^5.7.3"
  }
}
