# GreenPulse Web Configuration Template
# Copy to .env.local for local development
# Copy to .env.production for Vercel deployment

# ======================
# SERVER CONFIGURATION
# ======================
NODE_ENV=development
# Port is managed by @ezstart/config via getWebPort() — do not set here

# ======================
# API CONFIGURATION
# ======================
# ✅ MIGRATION NOTE: API URLs are now auto-configured via @ezstart/config
# You no longer need to set NEXT_PUBLIC_API_URL manually!
# The config package automatically detects environment and uses the correct URL:
#   - Local: http://localhost:6160
#   - Production: https://greenpulse-api.up.railway.app (Railway)
#
# If you need to override for testing, you can still set:
# NEXT_PUBLIC_API_URL=http://localhost:6160
#
# See packages/config/src/urls.ts for all configured URLs.

# ======================
# APPLICATION CONFIGURATION
# ======================
NEXT_PUBLIC_APP_NAME=GreenPulse.AI
NEXT_PUBLIC_APP_DESCRIPTION=ESG advisor for SMEs in Southeast Asia

# File Upload Settings
NEXT_PUBLIC_MAX_FILE_SIZE=52428800
NEXT_PUBLIC_ALLOWED_FILE_TYPES=audio/*,image/*,application/pdf

# ======================
# AUTHENTICATION CONFIGURATION
# ======================
# Note: EZAuth URLs are auto-configured in @ezstart/auth-sdk
#
# 🔐 JWT Public Key for Token Validation
# GreenPulse uses a custom domain (ai-greenpulse.com), not *.ezstart.xyz
# Therefore, it uses JWT mode for authentication instead of httpOnly cookies
#
# Get the PUBLIC key from EZAuth API:
#   1. Generate keys in ezauth-api (see apps/ezauth/api/.env.example)
#   2. Run: openssl rsa -in jwt-private.pem -pubout
#   3. Copy the output to this variable
#
# ⚠️ This is the PUBLIC key (safe to share), not the private key!
# ✅ The auth-sdk validates JWTs locally with this key (no API calls needed)
#
NEXT_PUBLIC_EZAUTH_JWT_PUBLIC_KEY=your-rsa-public-key-here-from-ezauth-api

# ======================
# PRODUCTION EXAMPLES
# ======================
# Web (Vercel): https://www.ai-greenpulse.com
# API (Railway): https://greenpulse-api.up.railway.app
