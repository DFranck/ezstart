# ============================================================
# GreenPulse Web — .env.example
# ============================================================

# ── Shared ────────────────────────────────────────────────
DEPLOY_ENV=local
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=ezstart

# ── EZAuth publishable key ────────────────────────────────
NEXT_PUBLIC_EZAUTH_KEY=

# ── API URL for Next.js rewrites (set in next.config.js) ──
NEXT_PUBLIC_API_URL=http://localhost:6160/api

# ── Optional ──────────────────────────────────────────────
NEXT_PUBLIC_DEBUG=false
