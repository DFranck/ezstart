# ============================================================
# GreenPulse Web — .env.example
# ============================================================

# ── Shared ────────────────────────────────────────────────
DEPLOY_ENV=local
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=ezstart

# ── EZAuth publishable key ────────────────────────────────
# Format: ez_pk_live_<64-hex> — see .claude/rules/standard-saas-keys.md
# Generated via: pnpm --filter api-ezauth seed:consumer-app-keys
NEXT_PUBLIC_EZAUTH_KEY=

# ── Application id (ezauth) — scoping pay-sdk components ──
# Used by admin/payments + admin/test-payments (no ezpay publishable key yet).
# Format: 24-char ObjectId — printed by seed:consumer-app-keys.
NEXT_PUBLIC_EZAUTH_APP_ID=

# ── API URL for Next.js rewrites (set in next.config.js) ──
NEXT_PUBLIC_API_URL=http://localhost:6160/api

# ── Optional ──────────────────────────────────────────────
NEXT_PUBLIC_DEBUG=false
