{
  "name": "web-green-pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node src/scripts/dev-with-port.js",
    "dev:port": "next dev -p $PORT",
    "build": "pnpm --filter @ezstart/config --filter @ezstart/ui --filter @ezstart/auth-sdk --filter @ezstart/next-theme build && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ezstart/auth-sdk": "workspace:*",
    "@ezstart/config": "workspace:*",
    "@ezstart/next-theme": "workspace:*",
    "@ezstart/ui": "workspace:*",
    "deepmerge": "^4.3.1",
    "next": "^15.5.2",
    "next-intl": "^4.1.0",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@ezstart/eslint-config": "workspace:*",
    "@ezstart/tailwind-config": "workspace:*",
    "@ezstart/next-config": "workspace:*",
    "@ezstart/seo-config": "workspace:*",
    "@ezstart/typescript-config": "workspace:*",
    "@types/node": "^22.10.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}