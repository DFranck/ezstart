{
  "name": "api-ez-billing",
  "version": "0.0.1",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "pnpm --filter @ezstart/types build && pnpm --filter @ez-billing/types build",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "pnpm build && node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@ez-billing/types": "workspace:*",
    "@ezstart/express-core": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.19.2",
    "mongoose": "^8.15.1",
    "node-cron": "^4.1.0",
    "puppeteer": "^24.9.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.7.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^6.0.3",
    "@ezstart/eslint-config": "workspace:*",
    "jest": "^29.7.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
