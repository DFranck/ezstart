{
  "extends": "@workspace/typescript-config/api.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "types": ["jest", "node"],
    "typeRoots": ["../../../packages/types", "./node_modules/@types"],
    "strict": false,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": ["**/*.ts", "**/*.tsx", "../../../packages/types/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
