{
  "name": "web-ez-billing",
  "description": "Billing management web app",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 5025",
    "build": "pnpm --filter @ezstart/ui --filter @ezstart/auth-sdk --filter @ezstart/next-theme --filter @ez-billing/types build && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ez-billing/types": "workspace:*",
    "@ezstart/auth-sdk": "workspace:*",
    "@ezstart/ui": "workspace:*",
    "@ezstart/next-theme": "workspace:*",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@react-pdf/renderer": "^4.3.0",
    "next": "^15.5.2",
    "next-themes": "^0.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sonner": "^2.0.3",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@ezstart/eslint-config": "workspace:*",
    "@ezstart/next-config": "workspace:*",
    "@ezstart/tailwind-config": "workspace:*",
    "@ezstart/typescript-config": "workspace:*",
    "typescript": "^5.7.3"
  }
}
