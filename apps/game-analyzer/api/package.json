{
  "name": "api-game-analyzer",
  "version": "0.0.1",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "prebuild": "pnpm --filter @ezstart/config build && pnpm --filter @ezstart/express-core build && pnpm --filter @game-analyzer/types build",
    "build": "tsc && ls -la dist",
    "start": "ls -la && ls -la dist && node dist/index.js",
    "start:prod": "pnpm build && node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ezstart/config": "workspace:*",
    "@ezstart/express-core": "workspace:*",
    "@ezstart/logger": "workspace:*",
    "@ezstart/ocr-sdk": "workspace:*",
    "@game-analyzer/types": "workspace:*",
    "@google/generative-ai": "^0.24.1",
    "express": "^4.19.2",
    "mongoose": "^8.15.1",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@ezstart/typescript-config": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.19.9",
    "tsx": "^4.20.0",
    "typescript": "^5.7.3"
  }
}
