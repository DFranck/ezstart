# FengShui Web Configuration Template
# Copy to .env.local for local development
# Copy to .env.production for Vercel deployment

# ======================
# SERVER CONFIGURATION
# ======================
# Port is managed by @ezstart/config via getWebPort() — do not set here

# ======================
# MONGODB
# ======================
MONGO_URL=mongodb://localhost:27017/fengshui

# ======================
# AI VALIDATION (Google Gemini Vision)
# ======================
GEMINI_API_KEY=your-gemini-api-key

# ======================
# EXTERNAL SERVICES
# ======================
# Note: EZAuth URLs are auto-configured in @ezstart/auth-sdk

# ======================
# PRODUCTION EXAMPLES
# ======================
# Web (Vercel): https://ezfengshui.ezstart.xyz