# ============================================================
# Fengshui Web — .env.example
# ============================================================
# Note: fengshui has NO separate api — the Next app runs server-side code
# in route handlers. Hence it needs MONGO_URL / JWT_SECRET + GEMINI key.
# ============================================================

# ── Shared across ALL apps ────────────────────────────────
DEPLOY_ENV=local
MONGO_URL=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>/{app}?retryWrites=true&w=majority
JWT_SECRET=
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=ezstart

# ── Server-side (route handlers) ──────────────────────────
# Used by validate.service.ts invoked from /api/validate route
GEMINI_API_KEY=

# ── Client-side (publishable keys) ────────────────────────
# Format: ez_pk_live_<64-hex> — see .claude/rules/standard-saas-keys.md
# Generated via: pnpm --filter api-ezauth seed:consumer-app-keys
NEXT_PUBLIC_EZAUTH_KEY=

# ── Optional ──────────────────────────────────────────────
NEXT_PUBLIC_DEBUG=false
