# ============================================================
# @ezstart — Monorepo ROOT env (TEMPLATE — committed, no values)
# ============================================================
# This file holds the SHARED vars only — vars that must be IDENTICAL
# across every app + layer. App-specific vars live in:
#   apps/<app>/<api|web>/.env.example  (template, committed)
#   apps/<app>/<api|web>/.env.local    (real values, gitignored)
#
# Load order at boot (hybrid root + per-app):
#   1. Root .env.{env}   ← THIS FILE — shared vars
#   2. apps/<app>/<layer>/.env.{env}  ← per-app vars (overrides if duplicate)
#
# Copy this file to:
#   - .env.local        → local dev       (gitignored)
#   - .env.staging      → staging env     (gitignored)
#   - .env.production   → production ref  (gitignored; Railway/Vercel is the real source)
# ============================================================

# ── Node / Deploy environment ───────────────────────────────
NODE_ENV=development
DEPLOY_ENV=local

# ── MongoDB (templated; {app} resolved at runtime per app) ───
# Each environment has its own MONGO_URL (separate cluster/credentials).
# Only {app} is interpolated — DB names are just the app name.
# Placeholders:
#   <USER>/<PASSWORD>  — your MongoDB Atlas credentials for this environment
#   {app}              — auto: 'ezbill', 'ezauth', etc. (via getMongoUrl)
MONGO_URL=mongodb+srv://<USER>:<PASSWORD>@cluster0.ccuqflu.mongodb.net/{app}?retryWrites=true&w=majority&appName=Cluster0

# ── JWT (same across every app — SSO interop) ────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=

# ── Test accounts (shared dev) — single SSO super admin ─────
# Used by e2e tests + dev scripts. Stays at root because cross-app.
TEST_GLOBAL_EMAIL=test-global@ezstart.dev
TEST_GLOBAL_USERNAME=test-global
TEST_GLOBAL_PASSWORD=TestGlobal123!
