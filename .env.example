# ============================================================
# @ezstart — Monorepo root env (TEMPLATE — committed, no values)
# ============================================================
# Copy this file to:
#   - .env.local        → local dev       (gitignored)
#   - .env.staging      → staging env     (gitignored; placeholders + staging secrets)
#   - .env.production   → production ref  (gitignored; Railway/Vercel is the real source)
#
# ARCHITECTURE: root-only, GENERIC names (no app prefix).
#
# Per-app values that depend on the app are interpolated at runtime via
# `@ezstart/config` helpers:
#
#   MONGO_URL=mongodb+srv://.../{app}-{env}?...
#     → getMongoUrl('ezbill')  // mongodb+srv://.../ezbill-dev?... (local)
#
#   SENTRY_DSN_EZAUTH=https://...
#     → getSentryDsn('ezauth')
#
# `JWT_SECRET` is shared across every app by design (SSO interop).
# Everything else is a single-consumer var — kept generic (no prefix) because
# the consumer context disambiguates it.
# ============================================================

# ── Node / Deploy environment ───────────────────────────────
NODE_ENV=development
DEPLOY_ENV=local

# ── MongoDB (templated; {app} + {env} resolved at runtime) ──
# Placeholders:
#   <DEV_PASSWORD>  — your MongoDB Atlas user password for the dev cluster
#   {app}           — auto: 'ezbill', 'ezauth', etc.
#   {env}           — auto: 'dev' (local/development), 'staging', 'prod'
MONGO_URL=mongodb+srv://<USER>:<DEV_PASSWORD>@cluster0.ccuqflu.mongodb.net/{app}-{env}?retryWrites=true&w=majority&appName=Cluster0

# ── JWT (same across every app — SSO) ────────────────────────
JWT_SECRET=

# ── Email ────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FULL_ACCESS_API_KEY=

# ── AI providers ────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_ADMIN_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_ADMIN_KEY=
GEMINI_API_KEY=

# ── Sentry (org-level + per-app DSNs) ───────────────────────
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=ezstart
SENTRY_DSN_EZAUTH=
SENTRY_DSN_EZBILL=
SENTRY_DSN_EZPAY=
SENTRY_DSN_EZSTART=
SENTRY_DSN_GREEN_PULSE=
SENTRY_DSN_GACHA_ANALYZER=

# ── MongoDB Atlas admin API (ezstart monitoring) ────────────
MONGODB_ATLAS_PUBLIC_KEY=
MONGODB_ATLAS_PRIVATE_KEY=
MONGODB_ATLAS_PROJECT_ID=

# ── Infra CLIs ──────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_USERNAME=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
RAILWAY_TOKEN=

# ── External APIs ───────────────────────────────────────────
EXCHANGE_RATE_API_KEY=

# ── Stripe (ezpay payments + ezstart services dashboard) ────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_* are readable from the client bundle (Next convention).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── EZAuth — OAuth Google + SSO ──────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:6110/api/auth/google/callback
OAUTH_STATE_SECRET=
OAUTH_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRES_IN=24h
COOKIE_DOMAIN=
SSO_ALLOWED_REDIRECTS=http://localhost:6111,http://localhost:6121,http://localhost:6131,http://localhost:6141,http://localhost:6151,http://localhost:6161,http://localhost:6171
REQUIRE_VERIFIED_EMAIL_FOR_SSO=false

# ── EZBill — cron runtime ───────────────────────────────────
RUN_EXCHANGE_RATES_ON_START=false

# ── EZStart — monitoring runtime ────────────────────────────
HEALTH_CHECK_INTERVAL=600000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3

# ── GreenPulse — ESG SaaS + webhooks ─────────────────────────
ESG_CLIENT_ID=
ESG_CLIENT_SECRET=
ESG_BASE_URL=https://api.esg-saas.example
WEBHOOK_SIGNING_SECRET=
MAX_FILE_SIZE=52428800
UPLOAD_DIR=uploads
CORS_ORIGIN=http://localhost:6161
LOG_LEVEL=info
# GreenPulse web (Next.js — NEXT_PUBLIC_* readable from client bundle)
NEXT_PUBLIC_APP_NAME=GreenPulse.AI
NEXT_PUBLIC_APP_DESCRIPTION=ESG advisor for SMEs in Southeast Asia
NEXT_PUBLIC_MAX_FILE_SIZE=52428800
NEXT_PUBLIC_ALLOWED_FILE_TYPES=audio/*,image/*,application/pdf
NEXT_PUBLIC_EZAUTH_JWT_PUBLIC_KEY=

# ── Test accounts (shared dev) — single SSO super admin ─────
TEST_GLOBAL_EMAIL=test-global@ezstart.dev
TEST_GLOBAL_USERNAME=test-global
TEST_GLOBAL_PASSWORD=TestGlobal123!
